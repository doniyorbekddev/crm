# =====================================================================
# Production muhit o'zgaruvchilari (docker-compose.prod.yml uchun)
# Nusxa oling:  cp .env.production.example .env.production
# Bu faylni hech qachon git'ga qo'shmang.
# =====================================================================

# --- PostgreSQL ---
POSTGRES_USER=crm
# Kuchli parol qo'ying:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=crm

# --- JWT kalitlari (har biri kamida 32 belgi, bir-biridan farqli) ---
# Generatsiya:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# --- Domen ---
# CORS va cookie uchun: brauzerda ochiladigan to'liq manzil
CLIENT_URL=https://crm.example.uz
# Cookie domeni (subdomenlar kerak bo'lsa: .example.uz). Bo'sh qoldirish ham mumkin.
COOKIE_DOMAIN=
VITE_APP_NAME=IT-Academy CRM

# Konteyner tashqariga chiqadigan port (Nginx/Traefik shu portga proxy qiladi)
HTTP_PORT=8080
# Shu port qaysi interfeysga bog'lanadi. 127.0.0.1 = faqat serverning o'zidan
# ko'rinadi (tavsiya etiladi: tashqi trafik host Nginx + HTTPS orqali keladi).
# Host Nginx'siz sinash kerak bo'lsa: 0.0.0.0
HTTP_BIND=127.0.0.1

# --- Ilova ---
# O'zbekiston vaqti = UTC+5 = 300 daqiqa
APP_UTC_OFFSET_MINUTES=300
LOG_LEVEL=info
SLOW_REQUEST_MS=800

# --- Email (parolni tiklash xatlari) ---
SMTP_HOST=
SMTP_PORT=587
# SSL/TLS (465-port uchun true, 587 uchun false)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sales CRM <no-reply@example.uz>
# Parolni tiklash havolasi necha daqiqa amal qiladi (5..1440)
PASSWORD_RESET_EXPIRES_MINUTES=30

# --- Telegram bot (ixtiyoriy) ---
# Token @BotFather dan olinadi. Bo'sh qoldirilsa CRM ishlayveradi, faqat Telegram
# xabarlari yuborilmaydi (navbatda "o'chirilgan" deb belgilanadi).
TELEGRAM_BOT_TOKEN=
# Webhook'ni himoyalash uchun tasodifiy satr: openssl rand -hex 24
# Telegram uni har so'rovda X-Telegram-Bot-Api-Secret-Token sarlavhasida qaytaradi.
TELEGRAM_WEBHOOK_SECRET=
# Bot foydalanuvchi nomi (masalan: markaz_crm_bot) — "Telegramda ochish" havolasi uchun
TELEGRAM_BOT_USERNAME=

# --- AI akademik markaz (ixtiyoriy, TZ 3.0 §30–41) ---
# Bo'sh — "qoidalar rejimi": faktlar, ballar va tavsiyalar CRM ma'lumotidan hisoblanadi.
# Kalit faqat shu faylda (serverda, 600 huquq bilan) — kodga, chatga yoki gitga yozilmaydi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=25000

# --- Kuzatuv (ixtiyoriy, TZ 3.0 §68) ---
# /metrics (Prometheus, ichki tarmoqdan): kamida 24 belgi — openssl rand -hex 24. Bo'sh — 404.
METRICS_TOKEN=
# Server xatolari → Sentry. Bo'sh — o'chiq.
SENTRY_DSN=
# Brauzer xatolari → Sentry (build paytida qo'shiladi; alohida frontend loyihasi). Bo'sh — o'chiq.
VITE_SENTRY_DSN=
