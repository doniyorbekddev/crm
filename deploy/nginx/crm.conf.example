# =====================================================================
# Host (server) Nginx: domen → 127.0.0.1:8080 (frontend konteyneri).
# Konteyner ichidagi Nginx statik fayllarni beradi va /api/ ni backendga uzatadi,
# shuning uchun bu yerda alohida /api bloki kerak emas — bitta proxy yetarli.
#
#   sudo cp deploy/nginx/crm.conf.example /etc/nginx/sites-available/crm
#   sudo nano /etc/nginx/sites-available/crm          # domenni yozing
#   sudo ln -s /etc/nginx/sites-available/crm /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d crm.example.uz            # HTTPS + HTTP→HTTPS redirect
#
# Certbot 443 blokini, sertifikat yo'llarini va 80 → 443 redirectni o'zi qo'shadi.
# =====================================================================

server {
    listen 80;
    listen [::]:80;
    server_name crm.example.uz;

    # Hujjat va chek rasmlari uchun (backend limiti MAX_UPLOAD_MB bilan mos)
    client_max_body_size 10m;

    # Server haqida ma'lumot bermaslik
    server_tokens off;

    access_log /var/log/nginx/crm-access.log;
    error_log  /var/log/nginx/crm-error.log;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
        # Hisobot eksporti kabi katta javoblar buferlanmasin
        proxy_buffering off;
    }
}
