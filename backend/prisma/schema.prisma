// =====================================================================
// Sales CRM — PostgreSQL sxemasi
// Hujjat: docs/ARCHITECTURE.md (2-bo‘lim, ERD)
// =====================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  TRIAL_BOOKED
  TRIAL_ATTENDED
  NEGOTIATION
  WON
  LOST
  CALLBACK
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
  CALL_LOGGED
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
  DOCUMENT_UPLOADED
  CONVERTED_TO_STUDENT
}

enum CallDirection {
  OUTGOING
  INCOMING
}

enum CallStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

/// Lead "qizigan"ligi — ball asosida avtomatik aniqlanadi
enum LeadTemperature {
  COLD
  WARM
  HOT
  VERY_HOT
}

enum CallResult {
  ANSWERED
  NO_ANSWER
  BUSY
  WRONG_NUMBER
  INTERESTED
  NOT_INTERESTED
  CALLBACK
}

/// OVERDUE saqlanmaydi: PENDING va dueAt < hozir bo‘lsa, API uni OVERDUE deb qaytaradi.
enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
}

enum CourseCategory {
  PROGRAMMING
  LANGUAGE
  DESIGN
  COMPUTER_LITERACY
  SCHOOL_PREPARATION
  OTHER
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum GroupStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum StudentStatus {
  ACTIVE
  FROZEN
  COMPLETED
  DROPPED
  GRADUATED
  /// Bitirgan va markaz bilan aloqada qoladigan o'quvchi (referral, qayta yozilish uchun)
  ALUMNI
}

/// O'quvchining ketib qolish xavfi. Bu — holat (StudentStatus) emas, alohida o'lchov:
/// o'quvchi bir vaqtda ACTIVE va CRITICAL bo'lishi mumkin.
enum RiskLevel {
  HEALTHY
  ATTENTION
  AT_RISK
  CRITICAL
}

enum PaymentMethod {
  CASH
  CARD
  CLICK
  PAYME
  UZUM
  BANK
  OTHER
}

enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// Xabar qaysi kanal orqali yetkaziladi
enum DeliveryChannel {
  IN_APP
  TELEGRAM
}

/// Yetkazish holati — navbat (outbox) uchun
enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  /// Qabul qiluvchida bu kanal ulanmagan yoki o'chirilgan
  SKIPPED
}

enum NotificationType {
  NEW_LEAD
  LEAD_ASSIGNED
  NEW_PAYMENT
  FOLLOW_UP_REMINDER
  FOLLOW_UP_OVERDUE
  NEW_STUDENT
  DEBT_REMINDER
  TRIAL_LESSON_REMINDER
  EXPENSE_APPROVAL
  SYSTEM
  DAILY_DIGEST
  /// Ota-onaga: farzandi darsga kelmadi
  CHILD_ABSENT
  /// Ota-ona/o'quvchiga: to'lov muddati yaqinlashdi
  PAYMENT_DUE_SOON
  /// Xodimga: past baho bilan fikr keldi
  NEGATIVE_FEEDBACK
  /// O'quvchi/ota-onaga: yangi uy vazifasi e'lon qilindi
  HOMEWORK_CREATED
  /// O'quvchi/ota-onaga: vazifa baholandi
  HOMEWORK_GRADED
  /// O'quvchi/ota-onaga: imtihon natijasi chiqdi
  EXAM_RESULT
  /// O'quvchiga: yangi darajaga ko'tarildi
  LEVEL_UP
  /// O'quvchi/ota-onaga: sertifikat berildi
  CERTIFICATE_ISSUED
  WEEKLY_REPORT
  HOMEWORK_DEADLINE
  HOMEWORK_RETURNED
  /// O'quvchi/ota-onaga: imtihon rejalashtirildi (yoki sanasi o'zgardi)
  EXAM_SCHEDULED
  /// Ota-onaga: imtihon yoki vazifada past natija (yumshoq, tavsiya bilan)
  LOW_SCORE
  /// Ota-onaga: farzandi darsga kechikib keldi
  ATTENDANCE_LATE
  /// O'qituvchiga: o'quvchining xavf darajasi oshdi (sabablar bilan)
  RISK_INCREASED
}

/// Bildirishnoma muhimligi — ro‘yxatda ajralib turishi va saralanishi uchun.
/// Qiymat turga qarab serverda qo‘yiladi, chaqiruvchi uni yozmaydi.
enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

// ---------------------------------------------------------------------
// USERS, ROLES, PERMISSIONS, SESSIONS
// ---------------------------------------------------------------------

model User {
  id                 String     @id @default(cuid())
  firstName          String     @db.VarChar(100)
  lastName           String     @db.VarChar(100)
  email              String     @unique @db.VarChar(255)
  phone              String?    @db.VarChar(32)
  passwordHash       String
  status             UserStatus @default(PENDING)
  roleId             String
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  /// Vaqtinchalik parol (kabinet ochilganda yoki xodim tiklaganda) — birinchi kirishda almashtirilishi shart
  mustChangePassword Boolean    @default(false)
  branchId           String     @default("branch_main")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  role                 Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  assignedLeads        Lead[]                @relation("LeadAssignee")
  createdLeads         Lead[]                @relation("LeadCreator")
  leadActivities       LeadActivity[]
  leadNotes            LeadNote[]
  calls                Call[]
  assignedFollowUps    FollowUp[]            @relation("FollowUpAssignee")
  createdFollowUps     FollowUp[]            @relation("FollowUpCreator")
  taughtCourses        Course[]
  taughtGroups         Group[]
  createdStudents      Student[]
  managedPayments      Payment[]             @relation("PaymentManager")
  acceptedPayments     Payment[]             @relation("PaymentAccountant")
  deletedPayments      Payment[]             @relation("PaymentDeletedBy")
  markedAttendances    Attendance[]
  uploadedDocuments    Document[]
  deletedDocuments     Document[]            @relation("DocumentDeletedBy")
  notifications        Notification[]
  notificationSettings NotificationSetting[]
  broadcasts           TelegramBroadcast[]   @relation("BroadcastCreator")
  auditLogs            AuditLog[]
  updatedSettings      Setting[]

  // O'quv markaz modullari
  preferences              UserPreference[]
  teacherProfile           TeacherProfile?
  taughtSessions           AttendanceSession[]    @relation("SessionTeacher")
  markedSessions           AttendanceSession[]    @relation("SessionMarkedBy")
  xpAwards                 XpTransaction[]        @relation("XpAwardedBy")
  createdSalaryRules       TeacherSalaryRule[]    @relation("SalaryRuleCreatedBy")
  approvedSalaries         TeacherSalaryPeriod[]  @relation("SalaryApprovedBy")
  salaryPaymentsCreated    TeacherSalaryPayment[] @relation("SalaryPaymentCreatedBy")
  createdTransactions      Transaction[]          @relation("TransactionCreatedBy")
  voidedTransactions       Transaction[]          @relation("TransactionVoidedBy")
  incomesResponsible       Income[]               @relation("IncomeResponsible")
  expensesResponsible      Expense[]              @relation("ExpenseResponsible")
  createdBudgets           Budget[]               @relation("BudgetCreatedBy")
  createdHomework          Homework[]             @relation("HomeworkTeacher")
  gradedSubmissions        HomeworkSubmission[]   @relation("SubmissionGradedBy")
  createdExams             Exam[]                 @relation("ExamTeacher")
  gradedExamResults        ExamResult[]           @relation("ExamResultGradedBy")
  salesTargets             SalesTarget[]          @relation("SalesTargetUser")
  createdSalesTargets      SalesTarget[]          @relation("SalesTargetCreatedBy")
  resolvedAlerts           Alert[]                @relation("AlertResolvedBy")
  alertsRead               Alert[]                @relation("AlertReadBy")
  taughtPayments           Payment[]              @relation("PaymentTeacher")
  commissionEntries        CommissionEntry[]      @relation("CommissionTeacher")
  createdCommissions       CommissionEntry[]      @relation("CommissionCreatedBy")
  unlockedSalaries         TeacherSalaryPeriod[]  @relation("SalaryUnlockedBy")
  createdAdjustments       PayrollAdjustment[]    @relation("AdjustmentCreatedBy")
  approvedAdjustments      PayrollAdjustment[]    @relation("AdjustmentApprovedBy")
  voidedAdjustments        PayrollAdjustment[]    @relation("AdjustmentVoidedBy")
  employee                 Employee?              @relation("EmployeeUser")
  createdEmployees         Employee[]             @relation("EmployeeCreatedBy")
  createdRefunds           PaymentRefund[]        @relation("PaymentRefundCreatedBy")
  closedFinancialPeriods   FinancialPeriod[]      @relation("FinancialPeriodClosedBy")
  reopenedFinancialPeriods FinancialPeriod[]      @relation("FinancialPeriodReopenedBy")
  approvedExpenses         Expense[]              @relation("ExpenseApprovedBy")
  rejectedExpenses         Expense[]              @relation("ExpenseRejectedBy")
  createdRecurringExpenses RecurringExpense[]     @relation("RecurringExpenseCreatedBy")
  groupChanges             StudentGroupChange[]   @relation("GroupChangeBy")
  statusChanges            StudentStatusChange[]
  /// Portal hisobi qaysi o'quvchiga tegishli (o'quvchi kabineti)
  studentAccount           Student?               @relation("StudentPortalAccount")
  /// Portal hisobi qaysi ota-onaga tegishli (ota-ona kabineti)
  parentAccount            Parent?                @relation("ParentPortalAccount")
  telegramLinks            TelegramLink[]
  markedTopics             StudentTopicProgress[]
  leadAssignmentRule       LeadAssignmentRule?
  createdQuestions         Question[]
  gradedAttempts           ExamAttempt[]
  issuedCertificates       Certificate[]          @relation("CertificateIssuer")
  revokedCertificates      Certificate[]          @relation("CertificateRevoker")
  grantedDiscounts         StudentDiscount[]      @relation("DiscountGrantedBy")
  revokedDiscounts         StudentDiscount[]      @relation("DiscountRevokedBy")
  createdPromoCodes        PromoCode[]            @relation("PromoCodeCreatedBy")
  rewardedReferrals        Referral[]             @relation("ReferralRewardedBy")
  receivedFeedback         Feedback[]             @relation("FeedbackTeacher")
  requestedLeaves          EmployeeLeave[]        @relation("LeaveRequestedBy")
  stockMovements           StockMovement[]        @relation("StockMovementCreatedBy")
  aiQueries                AiQuery[]
  aiAnalysesCreated        AiAnalysis[]           @relation("AiAnalysisCreatedBy")
  aiAnalysesDecided        AiAnalysis[]           @relation("AiAnalysisDecidedBy")
  savedAutomations         AutomationRule[]       @relation("AutomationUpdatedBy")
  createdPaymentIntents    PaymentIntent[]        @relation("PaymentIntentCreatedBy")
  decidedLeaves            EmployeeLeave[]        @relation("LeaveDecidedBy")
  handledFeedback          Feedback[]             @relation("FeedbackHandledBy")
  taughtLessons            Lesson[]               @relation("LessonTeacher")
  createdLessons           Lesson[]               @relation("LessonCreatedBy")
  createdRubrics           Rubric[]               @relation("RubricCreatedBy")

  branch                 Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  tasksAssigned          Task[]           @relation("TaskAssignee")
  tasksCreated           Task[]           @relation("TaskCreatedBy")
  automationRulesCreated AutomationRule[] @relation("AutomationCreatedBy")

  @@index([branchId])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  /// SUPER_ADMIN, ADMIN, SALES_MANAGER, CALL_CENTER, TEACHER, ACCOUNTANT
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  /// Tizim rollarini o‘chirib bo‘lmaydi
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  /// Masalan: lead.update
  key         String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  /// Token o‘zi emas, faqat SHA-256 hash saqlanadi
  tokenHash    String    @unique @db.VarChar(128)
  /// Bitta login sessiyasidan kelib chiqqan tokenlar oilasi (reuse detection uchun)
  familyId     String    @db.VarChar(50)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.VarChar(50)
  ip           String?   @db.VarChar(64)
  userAgent    String?   @db.VarChar(500)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------
// LEADS
// ---------------------------------------------------------------------

/// Filial. Bitta markazda ham bitta "Asosiy filial" yozuvi bo'ladi —
/// shunda ikkinchi filial ochilganda hech narsa qayta yozilmaydi.
model Branch {
  id        String   @id @default(cuid())
  /// MAIN, CHILONZOR, ...
  key       String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(32)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  employees    Employee[]
  leads        Lead[]
  students     Student[]
  groups       Group[]
  payments     Payment[]
  transactions Transaction[]
  incomes      Income[]
  expenses     Expense[]
  accounts     FinancialAccount[]
  rooms        Room[]
  feedback     Feedback[]
  products     Product[]

  @@map("branches")
}

/// Yangi leadni kimga biriktirish qoidasi (weighted round-robin).
/// Vazn kattaroq bo'lgan xodim ko'proq lead oladi; `lastAssignedAt` navbatni belgilaydi.
model LeadAssignmentRule {
  id             String    @id @default(cuid())
  userId         String    @unique
  /// Nisbiy ulush: 2 bo'lsa, vazni 1 bo'lgandan ikki barobar ko'p lead oladi
  weight         Int       @default(1) @db.SmallInt
  isActive       Boolean   @default(true)
  /// Bir kunda maksimal nechta lead (0 — cheksiz)
  dailyLimit     Int       @default(0) @db.SmallInt
  lastAssignedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("lead_assignment_rules")
}

model Source {
  id        String   @id @default(cuid())
  /// INSTAGRAM, TELEGRAM, ...
  key       String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads             Lead[]
  marketingExpenses Expense[]

  @@map("sources")
}

model Lead {
  id              String           @id @default(cuid())
  /// Foydalanuvchiga ko‘rinadigan raqam: L-000123
  number          Int              @unique @default(autoincrement())
  firstName       String           @db.VarChar(100)
  lastName        String?          @db.VarChar(100)
  phone           String           @db.VarChar(32)
  telegram        String?          @db.VarChar(64)
  email           String?          @db.VarChar(255)
  age             Int?             @db.SmallInt
  gender          Gender?
  address         String?          @db.VarChar(255)
  status          LeadStatus       @default(NEW)
  priority        LeadPriority     @default(MEDIUM)
  notes           String?
  lostReason      String?          @db.VarChar(255)
  nextFollowUpAt  DateTime?
  lastContactedAt DateTime?
  convertedAt     DateTime?
  sourceId        String
  courseId        String?
  assignedToId    String?
  createdById     String?
  branchId        String           @default("branch_main")
  /// Qiziqish bahosi 0–100 (leadScore.service hisoblaydi)
  score           Int?             @db.SmallInt
  temperature     LeadTemperature?
  /// Ball qanday yig'ilgani: [{key, label, points, detail}]
  scoreFactors    Json?
  scoreUpdatedAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  source     Source         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  course     Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?          @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  student    Student?
  referral   Referral?
  activities LeadActivity[]
  leadNotes  LeadNote[]
  calls      Call[]
  followUps  FollowUp[]
  documents  Document[]

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([status])
  @@index([assignedToId, status])
  @@index([assignedToId, createdAt])
  @@index([status, convertedAt])
  @@index([temperature, status])
  @@index([sourceId])
  @@index([courseId])
  @@index([createdAt])
  @@index([nextFollowUpAt])
  @@index([deletedAt])
  @@index([phone])
  // Qidiruv (ILIKE '%...%') uchun trigram indekslar — 100 000+ leadda ham tez
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_first_name_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_last_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_phone_trgm_idx")
  @@index([telegram(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_telegram_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_email_trgm_idx")
  @@map("leads")
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  userId      String?
  type        LeadActivityType
  description String           @db.VarChar(500)
  /// Masalan: { "from": "NEW", "to": "CONTACTED" }
  metadata    Json?
  createdAt   DateTime         @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([userId])
  @@map("lead_activities")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

model Call {
  id          String        @id @default(cuid())
  leadId      String
  managerId   String?
  direction   CallDirection @default(OUTGOING)
  status      CallStatus    @default(COMPLETED)
  result      CallResult?
  calledAt    DateTime      @default(now())
  durationSec Int           @default(0)
  notes       String?
  nextCallAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lead    Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  manager User? @relation(fields: [managerId], references: [id], onDelete: SetNull)

  @@index([leadId, calledAt])
  @@index([managerId, calledAt])
  @@index([calledAt])
  @@map("calls")
}

model FollowUp {
  id                String         @id @default(cuid())
  leadId            String
  assignedToId      String?
  createdById       String?
  title             String         @db.VarChar(200)
  notes             String?
  dueAt             DateTime
  remindAt          DateTime?
  reminderSentAt    DateTime?
  overdueNotifiedAt DateTime?
  status            FollowUpStatus @default(PENDING)
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User? @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assignedToId, status, dueAt])
  @@index([status, dueAt])
  @@index([status, remindAt])
  @@index([leadId])
  @@map("follow_ups")
}

// ---------------------------------------------------------------------
// COURSES, GROUPS, STUDENTS
// ---------------------------------------------------------------------

/// O'quvchining mavzu bo'yicha holati
enum TopicProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// Kurrikulum: Kurs → Modul → Mavzu. Modul — yirik bo'lim ("HTML asoslari"),
/// mavzu — bitta yoki bir necha darsda o'tiladigan birlik ("Formalar").
model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  title       String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics CourseTopic[]

  @@index([courseId, sortOrder])
  @@map("course_modules")
}

model CourseTopic {
  id          String   @id @default(cuid())
  moduleId    String
  title       String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  /// Taxminiy necha dars ketadi — jadval rejalashtirish uchun
  lessonCount Int      @default(1) @db.SmallInt
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module    CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  StudentTopicProgress[]
  mastery   TopicMastery[]
  sessions  AttendanceSession[]
  questions Question[]
  lessons   Lesson[]
  homework  Homework[]

  @@index([moduleId, sortOrder])
  @@map("course_topics")
}

/// O'quvchining bitta mavzu bo'yicha holati. Yozuv faqat holat o'zgarganda yaratiladi —
/// yozuvi yo'q mavzu NOT_STARTED hisoblanadi (yuz minglab bo'sh qator yaratilmaydi).
model StudentTopicProgress {
  id          String              @id @default(cuid())
  studentId   String
  topicId     String
  status      TopicProgressStatus @default(IN_PROGRESS)
  completedAt DateTime?
  markedById  String?
  note        String?             @db.VarChar(255)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  student  Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic    CourseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  markedBy User?       @relation(fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([studentId, topicId])
  @@index([topicId, status])
  @@map("student_topic_progress")
}

/// Mavzu o'zlashtirish holati (TZ 3.0 §27). Chegaralar sozlanadi (`mastery.settings`)
enum MasteryStatus {
  NOT_STARTED
  LEARNING
  PRACTICING
  MASTERED
}

/// O'quvchining mavzu bo'yicha o'zlashtirishi (0–100). Manbalar: imtihon mavzu kesimi, mavzuli
/// uy vazifasi, mavzuli dars davomati, LMS darslari. Yozuv faqat dalil bo'lganda yaratiladi —
/// yozuvi yo'q mavzu NOT_STARTED. Hisob `masteryService.recalculate` da (hooklar + tungi job).
model TopicMastery {
  id              String        @id @default(cuid())
  studentId       String
  topicId         String
  /// Baho — faqat baholash dalili (imtihon/vazifa) bo'lsa; aks holda null
  score           Int?          @db.SmallInt
  status          MasteryStatus @default(NOT_STARTED)
  examScore       Int?          @db.SmallInt
  homeworkScore   Int?          @db.SmallInt
  attendanceScore Int?          @db.SmallInt
  lessonScore     Int?          @db.SmallInt
  /// Dalillar soni: {examQuestions, homework, sessions, lessons}
  evidence        Json?
  calculatedAt    DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic   CourseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId])
  @@index([topicId, status])
  /// Mavzu kesimidagi o'rtacha baho (analitika)
  @@index([topicId, score])
  @@map("topic_mastery")
}

/// LMS darsi holati: qoralama o'quvchiga ko'rinmaydi, arxiv — yangi o'quvchilarga ham
enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonMaterialKind {
  FILE
  LINK
  VIDEO
}

/// LMS darsi (TZ 3.0 §14): Kurs → Modul → Mavzu → **Dars** → Material.
/// Dars sessiyasi (`AttendanceSession`) — jadvaldagi mashg'ulot; bu esa o'quv kontenti.
model Lesson {
  id              String       @id @default(cuid())
  topicId         String
  title           String       @db.VarChar(200)
  /// Qisqa tavsif (ro'yxatda ko'rinadi)
  description     String?      @db.VarChar(1000)
  /// Dars matni (konspekt) — oddiy matn, paragraf bilan
  content         String?
  teacherId       String?
  durationMinutes Int?         @db.SmallInt
  videoUrl        String?      @db.VarChar(500)
  sortOrder       Int          @default(0)
  status          LessonStatus @default(DRAFT)
  publishedAt     DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  topic     CourseTopic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  teacher   User?            @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  materials LessonMaterial[]
  progress  LessonProgress[]
  homework  Homework[]

  @@index([topicId, status, sortOrder])
  @@index([status, publishedAt])
  @@map("lessons")
}

/// Dars materiali: fayl (PDF/rasm — hujjatlar bilan bir xil siyosat), havola yoki video havola
model LessonMaterial {
  id           String             @id @default(cuid())
  lessonId     String
  kind         LessonMaterialKind
  title        String             @db.VarChar(200)
  url          String?            @db.VarChar(1000)
  storagePath  String?            @db.VarChar(500)
  originalName String?            @db.VarChar(255)
  mimeType     String?            @db.VarChar(100)
  size         Int?
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, sortOrder])
  @@map("lesson_materials")
}

/// O'quvchi darsni ochgan/tugatgan payt — kurs progressi va faollik uchun
model LessonProgress {
  id            String    @id @default(cuid())
  lessonId      String
  studentId     String
  firstViewedAt DateTime  @default(now())
  lastViewedAt  DateTime  @default(now())
  completedAt   DateTime?

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId, lastViewedAt])
  @@map("lesson_progress")
}

model Course {
  id             String         @id @default(cuid())
  name           String         @unique @db.VarChar(150)
  category       CourseCategory @default(OTHER)
  description    String?
  durationMonths Int            @db.SmallInt
  /// Kursning to‘liq narxi (so‘m)
  price          Decimal        @db.Decimal(14, 2)
  discountAmount Decimal        @default(0) @db.Decimal(14, 2)
  /// price - discountAmount (service tomonidan hisoblanadi)
  finalPrice     Decimal        @db.Decimal(14, 2)
  status         CourseStatus   @default(ACTIVE)
  teacherId      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  teacher      User?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  leads        Lead[]
  groups       Group[]
  students     Student[]
  payments     Payment[]
  homework     Homework[]
  exams        Exam[]
  modules      CourseModule[]
  questions    Question[]
  certificates Certificate[]
  feedback     Feedback[]

  @@index([status])
  @@index([category])
  @@map("courses")
}

/// O'quv xonasi. Guruh jadvali shu xonaga bog'lanadi va band qilish konflikti tekshiriladi.
model Room {
  id        String   @id @default(cuid())
  branchId  String   @default("branch_main")
  /// A1, LAB2, ...
  key       String   @db.VarChar(50)
  name      String   @db.VarChar(100)
  capacity  Int      @default(15) @db.SmallInt
  /// Jihozlar: ["Proyektor", "Doska", "12 ta kompyuter"]
  equipment String[]
  note      String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  groups Group[]

  /// Kalit filial ichida takrorlanmaydi (boshqa filialda ham "A1" bo'lishi mumkin)
  @@unique([branchId, key])
  @@index([branchId, isActive])
  @@map("rooms")
}

model Group {
  id           String      @id @default(cuid())
  name         String      @unique @db.VarChar(100)
  courseId     String
  teacherId    String?
  /// Eski matnli xona nomi — yangi yozuvlarda `roomId` ishlatiladi
  room         String?     @db.VarChar(50)
  roomId       String?
  startDate    DateTime    @db.Date
  endDate      DateTime?   @db.Date
  scheduleDays WeekDay[]
  /// "HH:mm"
  startTime    String      @db.VarChar(5)
  /// "HH:mm"
  endTime      String      @db.VarChar(5)
  capacity     Int         @default(15) @db.SmallInt
  status       GroupStatus @default(PLANNED)
  branchId     String      @default("branch_main")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  course       Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  roomRef      Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  teacher      User?                @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  students     Student[]
  attendances  Attendance[]
  sessions     AttendanceSession[]
  homework     Homework[]
  exams        Exam[]
  payments     Payment[]
  certificates Certificate[]
  feedback     Feedback[]
  changesFrom  StudentGroupChange[] @relation("GroupChangeFrom")
  changesTo    StudentGroupChange[] @relation("GroupChangeTo")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([courseId])
  @@index([teacherId])
  @@index([status])
  @@index([roomId])
  @@map("groups")
}

model Student {
  id              String        @id @default(cuid())
  /// Foydalanuvchiga ko‘rinadigan raqam: ST-000045
  number          Int           @unique @default(autoincrement())
  leadId          String?       @unique
  firstName       String        @db.VarChar(100)
  lastName        String        @db.VarChar(100)
  phone           String        @db.VarChar(32)
  parentPhone     String?       @db.VarChar(32)
  telegram        String?       @db.VarChar(64)
  email           String?       @db.VarChar(255)
  birthDate       DateTime?     @db.Date
  gender          Gender?
  address         String?       @db.VarChar(255)
  courseId        String
  groupId         String?
  contractNumber  String?       @unique @db.VarChar(50)
  /// Shartnoma tuzilgan paytdagi narx (kurs narxi keyin o‘zgarsa ham saqlanib qoladi)
  contractPrice   Decimal       @db.Decimal(14, 2)
  startDate       DateTime      @db.Date
  status          StudentStatus @default(ACTIVE)
  statusChangedAt DateTime?
  notes           String?
  createdById     String?
  branchId        String        @default("branch_main")
  /// Sog'lomlik bahosi 0–100 (studentRisk.service qayta hisoblaydi)
  /// Kabinetga kirish uchun hisob (ixtiyoriy) — o'quvchi portali
  userId          String?       @unique
  /// Do'stini taklif qilish kodi: R00045 (raqamdan hosil bo'ladi, o'zgarmaydi)
  referralCode    String?       @unique @db.VarChar(16)
  /// Faol chegirmalar yig'indisi (hisoblangan qiymat). Shartnoma narxidan oldingi narx =
  /// contractPrice + discountTotal
  discountTotal   Decimal       @default(0) @db.Decimal(14, 2)
  healthScore     Int?          @db.SmallInt
  riskLevel       RiskLevel?
  /// Risk sabablari: [{key, label, score, weight, value, hint}] — hisoblangan qiymat
  riskFactors     Json?
  riskUpdatedAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  group       Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  debt        Debt?
  payments    Payment[]
  attendances Attendance[]
  documents   Document[]

  // O'quv markaz modullari
  gamification      GamificationProfile?
  streak            Streak?
  xpTransactions    XpTransaction[]
  topicMastery      TopicMastery[]
  badges            StudentBadge[]
  parents           StudentParent[]
  submissions       HomeworkSubmission[]
  examResults       ExamResult[]
  progressSnapshots StudentProgressSnapshot[]
  incomes           Income[]
  installments      PaymentInstallment[]
  groupChanges      StudentGroupChange[]
  statusChanges     StudentStatusChange[]
  topicProgress     StudentTopicProgress[]
  examAttempts      ExamAttempt[]
  certificates      Certificate[]
  discounts         StudentDiscount[]
  feedback          Feedback[]
  stockMovements    StockMovement[]
  paymentIntents    PaymentIntent[]
  lessonProgress    LessonProgress[]
  referralsMade     Referral[]                @relation("ReferralReferrer")
  referredBy        Referral?                 @relation("ReferralReferred")
  user              User?                     @relation("StudentPortalAccount", fields: [userId], references: [id], onDelete: SetNull)

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  telegramLinks TelegramLink[]

  @@index([branchId])
  @@index([courseId])
  @@index([groupId])
  @@index([groupId, status, deletedAt])
  @@index([riskLevel, deletedAt])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_first_name_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_last_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_phone_trgm_idx")
  @@index([telegram(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_telegram_trgm_idx")
  @@map("students")
}

// ---------------------------------------------------------------------
// PAYMENTS, DEBTS, ATTENDANCE
// ---------------------------------------------------------------------

/// Har bir o‘quvchining balansi. To‘lov qo‘shilganda/o‘chirilganda tranzaksiya ichida qayta hisoblanadi.
model Debt {
  id              String     @id @default(cuid())
  studentId       String     @unique
  totalAmount     Decimal    @db.Decimal(14, 2)
  paidAmount      Decimal    @default(0) @db.Decimal(14, 2)
  remainingAmount Decimal    @db.Decimal(14, 2)
  status          DebtStatus @default(UNPAID)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([remainingAmount])
  @@index([status])
  @@map("debts")
}

/// To‘lov jadvali: shartnoma summasining muddatli qismlari. Holat saqlanmaydi — Debt.paidAmount
/// qismlarga muddat tartibida taqsimlanib hisoblanadi (bekor qilish va qaytarish jadvalga o‘zi ta’sir qiladi).
model PaymentInstallment {
  id        String   @id @default(cuid())
  studentId String
  sequence  Int      @db.SmallInt
  dueDate   DateTime @db.Date
  amount    Decimal  @db.Decimal(14, 2)
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sequence])
  @@index([studentId, dueDate])
  @@index([dueDate])
  @@map("payment_installments")
}

/// O‘quvchining guruh almashtirish tarixi. Guruh nomlari o‘sha paytdagi holatda saqlanadi —
/// guruh keyin qayta nomlansa yoki o‘chirilsa ham tarix o‘qiladi.
/// O'quvchi holati tarixi: kim, qachon, nimadan nimaga va **nima sababdan** o'zgartirdi.
model StudentStatusChange {
  id          String        @id @default(cuid())
  studentId   String
  fromStatus  StudentStatus
  toStatus    StudentStatus
  reason      String?       @db.VarChar(255)
  changedById String?
  changedAt   DateTime      @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([studentId, changedAt])
  @@index([toStatus, changedAt])
  @@index([changedAt])
  @@map("student_status_changes")
}

model StudentGroupChange {
  id            String   @id @default(cuid())
  studentId     String
  fromGroupId   String?
  toGroupId     String?
  fromGroupName String?  @db.VarChar(100)
  toGroupName   String?  @db.VarChar(100)
  reason        String?  @db.VarChar(255)
  changedById   String?
  changedAt     DateTime @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromGroup Group?  @relation("GroupChangeFrom", fields: [fromGroupId], references: [id], onDelete: SetNull)
  toGroup   Group?  @relation("GroupChangeTo", fields: [toGroupId], references: [id], onDelete: SetNull)
  changedBy User?   @relation("GroupChangeBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([studentId, changedAt])
  @@index([fromGroupId, changedAt])
  @@index([toGroupId, changedAt])
  @@index([changedAt])
  @@map("student_group_changes")
}

model Payment {
  id             String         @id @default(cuid())
  /// Onlayn to'lovdan kelgan bo'lsa — qaysi so'rovdan
  intent         PaymentIntent?
  /// Kvitansiya raqami
  number         Int            @unique @default(autoincrement())
  studentId      String
  /// To‘lov paytidagi kurs (snapshot)
  courseId       String
  amount         Decimal        @db.Decimal(14, 2)
  method         PaymentMethod
  paidAt         DateTime       @default(now())
  comment        String?
  /// Sotuvni amalga oshirgan manager (manager performance hisobotlari uchun)
  managerId      String?
  /// To‘lovni qabul qilgan xodim
  accountantId   String?
  deletedAt      DateTime?
  deletedById    String?
  deleteReason   String?        @db.VarChar(255)
  /// Moliyaviy daftardagi yozuv (tushum ikki marta hisoblanmasligi uchun)
  transactionId  String?        @unique
  /// Formadan kelgan so‘rov kaliti: tarmoq qayta urinishi yoki ikki marta bosish yangi to‘lov yaratmaydi
  idempotencyKey String?        @unique @db.VarChar(64)
  /// To‘lov paytidagi guruh va o‘qituvchi — o‘quvchi keyin boshqa guruhga o‘tsa ham foiz shu o‘qituvchiga qoladi
  groupId        String?
  teacherId      String?
  branchId       String         @default("branch_main")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  transaction       Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  manager           User?             @relation("PaymentManager", fields: [managerId], references: [id], onDelete: SetNull)
  accountant        User?             @relation("PaymentAccountant", fields: [accountantId], references: [id], onDelete: SetNull)
  deletedBy         User?             @relation("PaymentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  group             Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  teacher           User?             @relation("PaymentTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  commissionEntries CommissionEntry[]
  refunds           PaymentRefund[]

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([studentId])
  @@index([studentId, deletedAt])
  @@index([courseId])
  @@index([paidAt])
  @@index([method, paidAt])
  @@index([managerId, paidAt])
  @@index([deletedAt])
  @@index([teacherId, paidAt])
  @@map("payments")
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  groupId    String
  sessionId  String?
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?          @db.VarChar(255)
  markedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student  Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group    Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  session  AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  markedBy User?              @relation(fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([studentId, groupId, date])
  @@index([groupId, date])
  @@index([studentId, date])
  @@index([sessionId])
  @@map("attendances")
}

// ---------------------------------------------------------------------
// DOCUMENTS, NOTIFICATIONS, AUDIT, SETTINGS
// ---------------------------------------------------------------------

/// Hujjat turi: xodim hujjatlari (shartnoma, pasport, sertifikat) va moliyaviy cheklar
enum DocumentCategory {
  CONTRACT
  PASSPORT
  CERTIFICATE
  RECEIPT
  OTHER
}

model Document {
  id               String           @id @default(cuid())
  leadId           String?
  studentId        String?
  expenseId        String?
  incomeId         String?
  teacherProfileId String?
  employeeId       String?
  category         DocumentCategory @default(OTHER)
  /// Xodim hujjati nomi (masalan, "Mehnat shartnomasi 2026")
  title            String?          @db.VarChar(150)
  /// Shartnoma yoki pasport amal qilish muddati — ogohlantirish shu sana bo‘yicha
  expiresAt        DateTime?        @db.Date
  originalName     String           @db.VarChar(255)
  mimeType         String           @db.VarChar(100)
  size             Int
  storagePath      String           @unique @db.VarChar(500)
  /// Takroriy yuklashni aniqlash uchun
  sha256           String?          @db.VarChar(64)
  deletedAt        DateTime?
  deletedById      String?
  uploadedById     String?
  createdAt        DateTime         @default(now())

  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  student        Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy     User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  expense        Expense?        @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  income         Income?         @relation(fields: [incomeId], references: [id], onDelete: Restrict)
  teacherProfile TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  employee       Employee?       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  deletedBy      User?           @relation("DocumentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([studentId])
  @@index([expenseId])
  @@index([incomeId])
  @@index([teacherProfileId])
  @@index([employeeId])
  @@index([expiresAt])
  @@map("documents")
}

/// Telegram chat bilan bog'lanish. Egasi — xodim (`userId`), o'quvchi yoki ota-ona:
/// aynan bittasi to'ldiriladi (baza darajasidagi CHECK bilan kafolatlanadi).
/// Bog'lash `/start <linkCode>` orqali: kod CRM'da beriladi, bot uni webhookda qabul qiladi.
model TelegramLink {
  id             String    @id @default(cuid())
  /// Telegram chat identifikatori (bog'langandan keyin to'ladi)
  chatId         String?   @unique @db.VarChar(64)
  /// Bir martalik bog'lash kodi
  linkCode       String    @unique @db.VarChar(32)
  /// Kod shu vaqtdan keyin ishlamaydi — o'g'irlangan kod abadiy amal qilmasin
  codeExpiresAt  DateTime?
  /// Kod ishlatilgan vaqt. To'lgan bo'lsa kod qayta ishlatilmaydi (replay himoyasi)
  codeUsedAt     DateTime?
  /// Bog'lagan Telegram foydalanuvchisi — guruh chatida `chatId` dan farq qiladi
  telegramUserId String?   @db.VarChar(64)
  /// Oxirgi faollik — ishlatilmayotgan bog'lanishlarni topish uchun
  lastSeenAt     DateTime?
  userId         String?
  studentId      String?
  parentId       String?
  /// Telegramdagi ismi — xodim kimga yuborilayotganini ko'rishi uchun
  chatTitle      String?   @db.VarChar(150)
  verifiedAt     DateTime?
  /// Foydalanuvchi xabarlarni o'chirib qo'ygan bo'lsa
  isActive       Boolean   @default(true)
  /// Botdagi "Sozlamalar": avtomatik eslatmalar vaqtincha o'chirilgan (bog'lanish saqlanadi;
  /// markazning ommaviy e'lonlari baribir keladi)
  muted          Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  student    Student?               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent     Parent?                @relation(fields: [parentId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([studentId])
  @@index([parentId])
  @@index([verifiedAt])
  @@map("telegram_links")
}

/// Yetkazish navbati (outbox): tashqi kanalga yuborish asosiy so'rovni kutib qoldirmaydi,
/// xatolik bo'lsa qayta urinish mumkin va har bir urinish iz qoldiradi.
model NotificationDelivery {
  id             String          @id @default(cuid())
  notificationId String?
  channel        DeliveryChannel
  status         DeliveryStatus  @default(PENDING)
  /// Takrorlanmaslik kaliti: <dedupeKey>:<channel>
  dedupeKey      String?         @unique @db.VarChar(200)
  /// Ommaviy xabar bo'lsa — qaysi biri (statistika uchun)
  broadcastId    String?
  telegramLinkId String?
  title          String          @db.VarChar(200)
  body           String
  /// "photo" | "document" — bo'lsa xabar media bilan (izoh = body)
  mediaKind      String?         @db.VarChar(10)
  mediaFileId    String?         @db.VarChar(200)
  attempts       Int             @default(0) @db.SmallInt
  lastError      String?         @db.VarChar(500)
  /// Keyingi urinish vaqti (exponential backoff)
  nextAttemptAt  DateTime        @default(now())
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  notification Notification?      @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  telegramLink TelegramLink?      @relation(fields: [telegramLinkId], references: [id], onDelete: SetNull)
  broadcast    TelegramBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([notificationId])
  @@index([broadcastId])
  @@index([createdAt])
  @@map("notification_deliveries")
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  type       NotificationType
  priority   NotificationPriority @default(NORMAL)
  title      String               @db.VarChar(200)
  message    String
  entityType String?              @db.VarChar(50)
  entityId   String?              @db.VarChar(50)
  /// Bir xil eslatma ikki marta yuborilmasligi uchun (masalan: followup-overdue:<id>)
  dedupeKey  String?              @unique @db.VarChar(150)
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([userId, priority, readAt])
  @@map("notifications")
}

/// Telegram botdagi ko'p qadamli oqim holati.
///
/// Telegram suhbat holatini saqlamaydi: har xabar alohida keladi. Davomat olish yoki
/// ommaviy xabar yozish kabi bir necha qadamli ishlar uchun "qayerda to'xtaganimiz" shu
/// yerda turadi. Yozuv **muddatli**: yarim qolgan oqim abadiy osilib qolmaydi.
model TelegramSession {
  chatId    String   @id @db.VarChar(64)
  /// Oqim nomi, masalan: attendance, broadcast
  flow      String   @db.VarChar(50)
  /// Oqim ichidagi qadam
  step      String   @db.VarChar(50)
  /// Qadamlar orasida saqlanadigan ma'lumot (tanlangan guruh, sana va h.k.)
  data      Json     @default("{}")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("telegram_sessions")
}

/// Kiruvchi Telegram hodisasi natijasi
enum TelegramEventStatus {
  OK
  /// Tanilmagan yoki e'tiborsiz qoldirilgan xabar
  IGNORED
  /// Chat chegaradan oshdi
  THROTTLED
  FAILED
}

/// Kiruvchi Telegram update jurnali.
///
/// Chiquvchi xabarlar `NotificationDelivery` da yoziladi, kiruvchilari esa hech qayerda
/// yozilmasdi — "bot javob bermadi" degan shikoyatni tekshirishning iloji yo'q edi.
/// Xabar **matni saqlanmaydi**: faqat buyruq nomi, holati va vaqti — maxfiylik uchun.
model TelegramEvent {
  id             String              @id @default(cuid())
  chatId         String?             @db.VarChar(64)
  telegramUserId String?             @db.VarChar(64)
  /// message yoki callback_query
  kind           String              @db.VarChar(30)
  /// Buyruq yoki callback harakati (foydalanuvchi matni emas)
  action         String?             @db.VarChar(100)
  status         TelegramEventStatus @default(OK)
  /// Xato matni — foydalanuvchiga ko'rsatilmaydi, faqat tekshirish uchun
  error          String?             @db.VarChar(500)
  durationMs     Int?
  createdAt      DateTime            @default(now())

  @@index([chatId, createdAt])
  @@index([createdAt])
  @@map("telegram_events")
}

/// Ommaviy xabar auditoriyasi
enum BroadcastAudience {
  STUDENTS
  PARENTS
  TEACHERS
  STAFF
  GROUP
  COURSE
}

/// Ommaviy Telegram xabari (admin/rahbar yuboradi).
///
/// Xabarning o'zi yetkazish navbati (`NotificationDelivery`) orqali ketadi — Telegram
/// chegarasi va qayta urinish o'sha yerda. Bu yozuv "kim, kimga, nima" ni saqlaydi;
/// statistika (yuborildi/xato/kutmoqda) navbatdan `broadcastId` bo'yicha hisoblanadi.
model TelegramBroadcast {
  id          String            @id @default(cuid())
  createdById String?
  audience    BroadcastAudience
  /// GROUP/COURSE uchun — guruh yoki kurs id
  targetId    String?           @db.VarChar(50)
  /// Auditoriya nomi (guruh/kurs nomi) — keyin o'zgarsa ham jurnal o'zgarmasin
  label       String            @db.VarChar(150)
  message     String            @db.VarChar(2000)
  /// Rasm yoki hujjat bilan yuborilgan bo'lsa — Telegram file_id (bot o'zi qayta yuboradi)
  mediaKind   String?           @db.VarChar(10)
  mediaFileId String?           @db.VarChar(200)
  recipients  Int               @default(0)
  createdAt   DateTime          @default(now())

  createdBy  User?                  @relation("BroadcastCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([createdAt])
  @@map("telegram_broadcasts")
}

/// Xodimning bildirishnoma sozlamasi: qaysi turni ilovada va Telegramda olishni xohlaydi.
///
/// Yozuv **faqat foydalanuvchi standartni o‘zgartirsa** yaratiladi — qator yo‘q bo‘lsa,
/// ikkala kanal ham yoqilgan hisoblanadi. Shu sababli yangi tur qo‘shilganda hech kimga
/// migratsiya kerak emas va hech kim xabardan ayrilib qolmaydi.
model NotificationSetting {
  userId    String
  type      NotificationType
  /// Ilova ichidagi qo‘ng‘iroqchada ko‘rinadimi
  inApp     Boolean          @default(true)
  /// Telegramga yuborilsinmi
  telegram  Boolean          @default(true)
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_settings")
}

/// Xodimning shaxsiy sozlamalari (dashboard vidjetlari tartibi va boshqalar). Kalit — ruxsat etilganlar ro‘yxatidan
model UserPreference {
  userId    String
  key       String   @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("user_preferences")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  /// Masalan: lead.status_changed, payment.created, user.created
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String?  @db.VarChar(50)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(500)
  /// Amal bilan bog'liq qo'shimcha ma'lumot (qaysi yozuv, qancha summa va h.k.)
  metadata   Json?
  /// O'zgarishdan oldingi qiymatlar — faqat tahrirlash amallarida to'ldiriladi
  before     Json?
  /// O'zgarishdan keyingi qiymatlar
  after      Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model Setting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

// =====================================================================
// O‘QUV MARKAZ MODULLARI
// Davomat seanslari, gamification, o‘qituvchi va maosh, moliya,
// uy vazifasi, imtihon, progress, ota-ona, target va alertlar.
// =====================================================================

enum AttendanceSessionStatus {
  PLANNED
  HELD
  CANCELLED
}

enum XpSource {
  ATTENDANCE
  HOMEWORK
  EXAM
  STREAK
  REFERRAL
  COURSE_COMPLETED
  BADGE
  MANUAL
}

/// Badge qanday qoida bo‘yicha beriladi
enum BadgeRule {
  MANUAL
  STREAK_DAYS
  ATTENDANCE_RATE
  HOMEWORK_COUNT
  EXAM_SCORE
  XP_TOTAL
  COURSE_COMPLETED
}

enum SalaryType {
  FIXED
  PER_LESSON
  PER_STUDENT
  PERCENTAGE
  MIXED
}

enum SalaryPeriodStatus {
  PENDING
  CALCULATED
  APPROVED
  PARTIALLY_PAID
  PAID
}

enum AccountType {
  CASH
  BANK
  CARD
  UZCARD
  HUMO
  CLICK
  PAYME
  UZUM
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
}

/// Moliyaviy yozuv o‘chirilmaydi — VOID yoki REVERSED holatiga o‘tadi
enum TransactionStatus {
  COMPLETED
  VOID
  REVERSED
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  /// Boshlanmagan (TZ: NOT_STARTED)
  PENDING
  /// Qoralama saqlangan yoki fayl yuklangan, hali topshirilmagan
  IN_PROGRESS
  SUBMITTED
  LATE
  /// Baholangan (TZ: CHECKED)
  GRADED
  /// O'qituvchi qayta ishlashga qaytargan — o'quvchi qayta topshiradi
  RETURNED
  MISSED
}

/// Vazifa kimga: butun guruh (keyin qo'shilganlar ham), tanlanganlar yoki bitta o'quvchi
enum HomeworkTarget {
  GROUP
  SELECTED
  INDIVIDUAL
}

enum ExamStatus {
  PLANNED
  HELD
  GRADED
  CANCELLED
}

enum ParentRelation {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

enum AlertType {
  HIGH_DEBT
  LOW_ATTENDANCE
  HIGH_DROPOUT
  OVERDUE_FOLLOWUPS
  UNPAID_SALARY
  BUDGET_EXCEEDED
  LOW_GROUP_CAPACITY
  SALES_TARGET_ACHIEVED
  CONVERSION_DROP
  DROPOUT_INCREASE
  CASH_SHORTAGE
  PENDING_EXPENSE_APPROVAL
  DOCUMENT_EXPIRING
  PAYMENT_OVERDUE
  /// Avtomatlashtirish qoidasi yaratgan akademik xavf (TZ §50)
  ACADEMIC_RISK
}

enum AlertSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum TargetType {
  LEADS
  SALES
  REVENUE
}

// ---------------------------------------------------------------------
// DAVOMAT SEANSLARI (dars)
// ---------------------------------------------------------------------

/// Bitta o‘tilgan dars. Davomat yozuvlari shu seansga bog‘lanadi —
/// o‘qituvchi maoshi (per lesson) va uy vazifasi shu orqali hisoblanadi.
model AttendanceSession {
  id         String                  @id @default(cuid())
  groupId    String
  teacherId  String?
  date       DateTime                @db.Date
  /// "HH:mm"
  startTime  String?                 @db.VarChar(5)
  endTime    String?                 @db.VarChar(5)
  /// Erkin matnli mavzu (eski usul, saqlanadi)
  topic      String?                 @db.VarChar(200)
  /// Kurrikulumdagi mavzu — belgilansa, davomat bilan birga progress yangilanadi
  topicId    String?
  note       String?                 @db.VarChar(500)
  status     AttendanceSessionStatus @default(HELD)
  markedById String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  group           Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  curriculumTopic CourseTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  teacher         User?        @relation("SessionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  markedBy        User?        @relation("SessionMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  attendances     Attendance[]

  @@unique([groupId, date])
  @@index([teacherId, date])
  @@index([date])
  @@index([status, date])
  @@index([createdAt])
  @@map("attendance_sessions")
}

// ---------------------------------------------------------------------
// GAMIFICATION
// ---------------------------------------------------------------------

/// O‘quvchining XP va darajasi (keshlangan holat — XpTransaction'lardan hisoblanadi)
model GamificationProfile {
  id          String    @id @default(cuid())
  studentId   String    @unique
  totalXp     Int       @default(0)
  levelNumber Int       @default(1)
  lastXpAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([totalXp])
  @@map("gamification_profiles")
}

/// XP berish qoidalari — admin o‘zgartira oladi
model XpRule {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(255)
  source      XpSource
  points      Int
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("xp_rules")
}

model XpTransaction {
  id          String   @id @default(cuid())
  studentId   String
  points      Int
  source      XpSource
  ruleKey     String?  @db.VarChar(50)
  description String   @db.VarChar(255)
  entityType  String?  @db.VarChar(50)
  entityId    String?  @db.VarChar(50)
  awardedById String?
  /// Bir hodisa uchun XP ikki marta berilmasligi uchun: "attendance:<id>"
  dedupeKey   String?  @unique @db.VarChar(150)
  createdAt   DateTime @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  awardedBy User?   @relation("XpAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
  @@map("xp_transactions")
}

/// Daraja chegaralari — admin sozlaydi
model Level {
  id        String   @id @default(cuid())
  number    Int      @unique
  name      String   @db.VarChar(100)
  minXp     Int      @unique
  icon      String?  @db.VarChar(16)
  color     String?  @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("levels")
}

model Badge {
  id          String    @id @default(cuid())
  key         String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String    @db.VarChar(255)
  icon        String    @db.VarChar(16)
  rule        BadgeRule @default(MANUAL)
  /// Qoida uchun chegara: streak kunlari, davomat foizi, XP va h.k.
  threshold   Int?
  xpReward    Int       @default(0)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  students StudentBadge[]

  @@map("badges")
}

model StudentBadge {
  id        String   @id @default(cuid())
  studentId String
  badgeId   String
  note      String?  @db.VarChar(255)
  awardedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge   Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
  @@index([awardedAt])
  @@map("student_badges")
}

/// Ketma-ket qatnashish. Davomat belgilanganda avtomatik yangilanadi.
model Streak {
  id                 String    @id @default(cuid())
  studentId          String    @unique
  current            Int       @default(0)
  longest            Int       @default(0)
  lastAttendanceDate DateTime? @db.Date
  updatedAt          DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([current])
  @@map("streaks")
}

// ---------------------------------------------------------------------
// O‘QITUVCHI VA MAOSH
// ---------------------------------------------------------------------

/// O‘qituvchi ma'lumotlari. Shaxs va kirish ma'lumotlari `User` da qoladi —
/// bu yerda faqat o‘qituvchilik profili saqlanadi.
model TeacherProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  specialization   String?        @db.VarChar(150)
  experienceYears  Int?           @db.SmallInt
  hireDate         DateTime?      @db.Date
  bio              String?
  isActive         Boolean        @default(true)
  /// HR holati; isActive shundan kelib chiqadi (faol yoki ta’tilda — true)
  employmentStatus EmployeeStatus @default(ACTIVE)
  terminationDate  DateTime?      @db.Date
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaryRules   TeacherSalaryRule[]
  salaryPeriods TeacherSalaryPeriod[]
  documents     Document[]

  @@index([isActive])
  @@index([employmentStatus])
  @@map("teacher_profiles")
}

/// Maosh modeli. Yangi qoida qo‘shilganda eskisi tarix uchun saqlanadi.
model TeacherSalaryRule {
  id               String     @id @default(cuid())
  teacherProfileId String
  type             SalaryType
  baseSalary       Decimal    @default(0) @db.Decimal(14, 2)
  perLessonRate    Decimal    @default(0) @db.Decimal(14, 2)
  perStudentRate   Decimal    @default(0) @db.Decimal(14, 2)
  /// Guruh tushumidan ulush (%)
  percentage       Decimal    @default(0) @db.Decimal(5, 2)
  bonus            Decimal    @default(0) @db.Decimal(14, 2)
  effectiveFrom    DateTime   @db.Date
  effectiveTo      DateTime?  @db.Date
  isActive         Boolean    @default(true)
  note             String?    @db.VarChar(255)
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  createdBy      User?          @relation("SalaryRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([teacherProfileId, effectiveFrom])
  @@index([isActive])
  @@map("teacher_salary_rules")
}

/// Bir oylik maosh hisobi. Approve qilingandan keyin o‘zgarmaydi (lockedAt).
model TeacherSalaryPeriod {
  id               String             @id @default(cuid())
  /// To‘lov oluvchi: o‘qituvchi yoki xodim (aynan bittasi — bazada CHECK cheklovi)
  teacherProfileId String?
  employeeId       String?
  year             Int
  month            Int                @db.SmallInt
  salaryType       SalaryType
  lessonsCount     Int                @default(0)
  studentsCount    Int                @default(0)
  groupRevenue     Decimal            @default(0) @db.Decimal(14, 2)
  baseAmount       Decimal            @default(0) @db.Decimal(14, 2)
  lessonAmount     Decimal            @default(0) @db.Decimal(14, 2)
  studentAmount    Decimal            @default(0) @db.Decimal(14, 2)
  percentageAmount Decimal            @default(0) @db.Decimal(14, 2)
  /// Hisoblashda qo‘llangan foiz (tarix uchun)
  commissionRate   Decimal            @default(0) @db.Decimal(5, 2)
  /// Maosh modelidagi oylik bonus; qolgan bonus va jarimalar — PayrollAdjustment yozuvlari
  modelBonus       Decimal            @default(0) @db.Decimal(14, 2)
  bonus            Decimal            @default(0) @db.Decimal(14, 2)
  penalty          Decimal            @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal            @default(0) @db.Decimal(14, 2)
  paidAmount       Decimal            @default(0) @db.Decimal(14, 2)
  remainingAmount  Decimal            @default(0) @db.Decimal(14, 2)
  status           SalaryPeriodStatus @default(PENDING)
  note             String?            @db.VarChar(255)
  calculatedAt     DateTime?
  approvedAt       DateTime?
  approvedById     String?
  lockedAt         DateTime?
  unlockedAt       DateTime?
  unlockedById     String?
  unlockReason     String?            @db.VarChar(255)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  teacherProfile    TeacherProfile?        @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  approvedBy        User?                  @relation("SalaryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  unlockedBy        User?                  @relation("SalaryUnlockedBy", fields: [unlockedById], references: [id], onDelete: SetNull)
  employee          Employee?              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payments          TeacherSalaryPayment[]
  commissionEntries CommissionEntry[]
  adjustments       PayrollAdjustment[]

  @@unique([teacherProfileId, year, month])
  @@unique([employeeId, year, month])
  @@index([year, month])
  @@index([status])
  @@map("teacher_salary_periods")
}

model TeacherSalaryPayment {
  id          String            @id @default(cuid())
  periodId    String
  amount      Decimal           @db.Decimal(14, 2)
  kind        SalaryPaymentKind @default(SALARY)
  method      PaymentMethod     @default(CASH)
  accountId   String?
  paidAt      DateTime          @default(now())
  note        String?           @db.VarChar(255)
  createdById String?
  createdAt   DateTime          @default(now())

  period    TeacherSalaryPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  account   FinancialAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy User?               @relation("SalaryPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expense   Expense?

  @@index([periodId])
  @@index([paidAt])
  @@map("teacher_salary_payments")
}

// ---------------------------------------------------------------------
// MOLIYA
// ---------------------------------------------------------------------

/// Kassa/hisob: naqd, bank, karta, Click, Payme, Uzum
model FinancialAccount {
  id          String      @id @default(cuid())
  key         String      @unique @db.VarChar(50)
  name        String      @db.VarChar(100)
  type        AccountType
  /// Joriy qoldiq — tranzaksiyalar bilan birga yangilanadi
  balance     Decimal     @default(0) @db.Decimal(14, 2)
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  description String?     @db.VarChar(255)
  branchId    String      @default("branch_main")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  transactions      Transaction[]
  incomes           Income[]
  expenses          Expense[]
  salaryPayments    TeacherSalaryPayment[]
  refunds           PaymentRefund[]
  recurringExpenses RecurringExpense[]

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@map("financial_accounts")
}

/// Yagona moliyaviy daftar (ledger). Har bir to‘lov, tushum va xarajat shu yerga tushadi.
model Transaction {
  id           String            @id @default(cuid())
  number       Int               @unique @default(autoincrement())
  type         TransactionType
  status       TransactionStatus @default(COMPLETED)
  amount       Decimal           @db.Decimal(14, 2)
  accountId    String?
  occurredAt   DateTime          @default(now())
  description  String?           @db.VarChar(255)
  categoryName String?           @db.VarChar(100)
  entityType   String?           @db.VarChar(50)
  entityId     String?           @db.VarChar(50)
  createdById  String?
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?           @db.VarChar(255)
  reversalOfId String?           @unique
  branchId     String            @default("branch_main")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  account       FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy      User?             @relation("TransactionVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  reversalOf    Transaction?      @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy    Transaction?      @relation("TransactionReversal")
  payment       Payment?
  income        Income?
  expense       Expense?
  paymentRefund PaymentRefund?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([occurredAt])
  @@index([type, occurredAt])
  @@index([status, occurredAt])
  @@index([entityType, entityId])
  @@map("transactions")
}

model IncomeCategory {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incomes Income[]

  @@map("income_categories")
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  budgetLines       BudgetLine[]

  @@map("expense_categories")
}

/// O‘quv to‘lovidan tashqari tushumlar (ro‘yxatga olish, kitob, forma va h.k.)
model Income {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  categoryId    String
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod @default(CASH)
  accountId     String?
  receivedAt    DateTime      @default(now())
  description   String?       @db.VarChar(255)
  studentId     String?
  responsibleId String?
  transactionId String        @unique
  branchId      String        @default("branch_main")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category    IncomeCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account     FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  student     Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  responsible User?             @relation("IncomeResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  transaction Transaction       @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  documents   Document[]

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([receivedAt])
  @@index([categoryId, receivedAt])
  @@map("incomes")
}

model Expense {
  id                 String        @id @default(cuid())
  number             Int           @unique @default(autoincrement())
  categoryId         String
  amount             Decimal       @db.Decimal(14, 2)
  method             PaymentMethod @default(CASH)
  accountId          String?
  spentAt            DateTime      @default(now())
  description        String?       @db.VarChar(255)
  attachmentPath     String?       @db.VarChar(500)
  responsibleId      String?
  /// To‘lanmagan (kutilayotgan / tasdiq kutayotgan) xarajatda daftar yozuvi yo‘q
  transactionId      String?       @unique
  /// Maosh to‘lovi xarajat sifatida yozilganda
  salaryPaymentId    String?       @unique
  status             ExpenseStatus @default(PAID)
  vendor             String?       @db.VarChar(150)
  /// Reklama xarajati qaysi lead manbasiga (kanalga) tegishli — manba bo‘yicha ROI uchun
  sourceId           String?
  /// Takroriy xarajatning to‘lov kuni
  dueDate            DateTime?     @db.Date
  approvedById       String?
  approvedAt         DateTime?
  rejectedById       String?
  rejectedAt         DateTime?
  rejectReason       String?       @db.VarChar(255)
  recurringExpenseId String?
  /// "2026-09" — takroriy xarajat qaysi oy uchun yaratilgani
  recurringPeriod    String?       @db.VarChar(7)
  branchId           String        @default("branch_main")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  category      ExpenseCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account       FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  responsible   User?                 @relation("ExpenseResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  transaction   Transaction?          @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  salaryPayment TeacherSalaryPayment? @relation(fields: [salaryPaymentId], references: [id], onDelete: SetNull)

  approvedBy       User?             @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy       User?             @relation("ExpenseRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  documents        Document[]
  source           Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([recurringExpenseId, recurringPeriod])
  @@index([branchId])
  @@index([status])
  @@index([spentAt])
  @@index([categoryId, spentAt])
  @@index([sourceId, spentAt])
  @@index([createdAt])
  @@map("expenses")
}

/// Oylik budjet
model Budget {
  id          String   @id @default(cuid())
  year        Int
  month       Int      @db.SmallInt
  note        String?  @db.VarChar(255)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?        @relation("BudgetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines     BudgetLine[]

  @@unique([year, month])
  @@map("budgets")
}

model BudgetLine {
  id            String  @id @default(cuid())
  budgetId      String
  categoryId    String
  plannedAmount Decimal @db.Decimal(14, 2)
  note          String? @db.VarChar(255)

  budget   Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([budgetId, categoryId])
  @@map("budget_lines")
}

// ---------------------------------------------------------------------
// OTA-ONA
// ---------------------------------------------------------------------

model Parent {
  id        String   @id @default(cuid())
  /// Kabinetga kirish uchun hisob (ixtiyoriy) — ota-ona portali
  userId    String?  @unique
  firstName String   @db.VarChar(100)
  lastName  String   @db.VarChar(100)
  phone     String   @db.VarChar(32)
  telegram  String?  @db.VarChar(64)
  email     String?  @db.VarChar(255)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students      StudentParent[]
  user          User?           @relation("ParentPortalAccount", fields: [userId], references: [id], onDelete: SetNull)
  telegramLinks TelegramLink[]

  @@index([phone])
  @@map("parents")
}

model StudentParent {
  id        String         @id @default(cuid())
  studentId String
  parentId  String
  relation  ParentRelation @default(GUARDIAN)
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@map("student_parents")
}

// ---------------------------------------------------------------------
// UY VAZIFASI VA IMTIHON
// ---------------------------------------------------------------------

model Homework {
  id             String              @id @default(cuid())
  title          String              @db.VarChar(200)
  description    String?
  courseId       String?
  groupId        String
  teacherId      String?
  assignedAt     DateTime            @default(now())
  deadline       DateTime
  maxPoints      Int                 @default(100) @db.SmallInt
  xpReward       Int                 @default(20)
  attachmentPath String?             @db.VarChar(500)
  status         HomeworkStatus      @default(PUBLISHED)
  /// Kurs dasturidagi mavzu va dars (LMS) — mastery va hisobotlar uchun
  topicId        String?
  lessonId       String?
  difficulty     QuestionDifficulty?
  targetType     HomeworkTarget      @default(GROUP)
  rubricId       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  course      Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  group       Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher     User?                @relation("HomeworkTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  submissions HomeworkSubmission[]
  topic       CourseTopic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  lesson      Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  rubric      Rubric?              @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  attachments HomeworkAttachment[]

  @@index([groupId, deadline])
  @@index([status, deadline])
  @@index([createdAt])
  @@index([topicId])
  @@map("homework")
}

model HomeworkSubmission {
  id             String           @id @default(cuid())
  homeworkId     String
  studentId      String
  status         SubmissionStatus @default(PENDING)
  submittedAt    DateTime?
  score          Int?             @db.SmallInt
  feedback       String?          @db.VarChar(500)
  /// O'quvchining matnli javobi (Telegram yoki kabinetdan topshirilganda)
  answerText     String?          @db.VarChar(2000)
  attachmentPath String?          @db.VarChar(500)
  /// Havola (GitHub, CodePen, Figma…) — faqat http(s)
  linkUrl        String?          @db.VarChar(1000)
  /// Kod javobi (matn sifatida saqlanadi, bajarilmaydi)
  codeText       String?
  codeLanguage   String?          @db.VarChar(30)
  /// Rubrika bo'yicha ballar: {mezonKaliti: 0–100}
  rubricScores   Json?
  returnedAt     DateTime?
  gradedById     String?
  gradedAt       DateTime?
  xpAwarded      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  homework    Homework               @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy    User?                  @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  attachments SubmissionAttachment[]

  @@unique([homeworkId, studentId])
  @@index([studentId, status])
  /// Baholash navbati va vazifa analitikasi (TZ 3.0 §46)
  @@index([homeworkId, status])
  @@map("homework_submissions")
}

/// O'qituvchi vazifaga biriktirgan fayl yoki havola
model HomeworkAttachment {
  id           String             @id @default(cuid())
  homeworkId   String
  kind         LessonMaterialKind
  title        String             @db.VarChar(200)
  url          String?            @db.VarChar(1000)
  storagePath  String?            @db.VarChar(500)
  originalName String?            @db.VarChar(255)
  mimeType     String?            @db.VarChar(100)
  size         Int?
  createdAt    DateTime           @default(now())

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([homeworkId])
  @@map("homework_attachments")
}

/// O'quvchi topshirig'idagi fayl (bir nechta bo'lishi mumkin)
model SubmissionAttachment {
  id           String   @id @default(cuid())
  submissionId String
  storagePath  String   @db.VarChar(500)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  size         Int
  createdAt    DateTime @default(now())

  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_attachments")
}

/// Baholash mezonlari (TZ §20): [{key, title, weight}] — og'irliklar yig'indisi 100
model Rubric {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  criteria    Json
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?      @relation("RubricCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  homework  Homework[]

  @@index([isActive])
  @@map("rubrics")
}

/// Savol turi. TEXT — qo'lda baholanadi, qolganlari avtomatik.
enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  /// Eski "matnli" savol — uzun javob sifatida qo'lda baholanadi
  TEXT
  TRUE_FALSE
  /// Qisqa javob: qabul qilinadigan javoblardan biriga mos kelsa — avtomatik
  SHORT_TEXT
  LONG_TEXT
  CODE
  FILE_UPLOAD
}

/// Baholash turi (TZ §21)
enum ExamType {
  DAILY_QUIZ
  WEEKLY_TEST
  MONTHLY_EXAM
  MIDTERM
  FINAL
  PRACTICE
  DIAGNOSTIC
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  /// Vaqt tugagach topshirilmagan urinish
  EXPIRED
  SUBMITTED
  /// Avtomatik baholangan, lekin matnli javoblar qo'lda baholanishi kerak
  NEEDS_REVIEW
  GRADED
}

/// Savollar bazasi. Savol kursga (va ixtiyoriy ravishda mavzuga) tegishli bo'ladi —
/// shunda imtihon natijasini mavzular kesimida tahlil qilish mumkin.
model Question {
  id              String             @id @default(cuid())
  courseId        String
  topicId         String?
  text            String             @db.VarChar(1000)
  type            QuestionType       @default(SINGLE_CHOICE)
  difficulty      QuestionDifficulty @default(MEDIUM)
  /// Standart ball — imtihonga qo'shilganda o'zgartirish mumkin
  points          Int                @default(1) @db.SmallInt
  /// Matnli savol uchun namunaviy javob (o'qituvchiga yordam)
  answerHint      String?            @db.VarChar(500)
  /// Natijadan keyin o'quvchiga ko'rsatiladigan tushuntirish
  explanation     String?            @db.VarChar(1000)
  tags            String[]           @default([])
  /// SHORT_TEXT uchun qabul qilinadigan javoblar (katta-kichik harf va bo'sh joy e'tiborsiz)
  acceptedAnswers String[]           @default([])
  isActive        Boolean            @default(true)
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic         CourseTopic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  options       QuestionOption[]
  examQuestions ExamQuestion[]
  answers       ExamAnswer[]

  @@index([courseId, isActive])
  @@index([topicId])
  @@index([difficulty])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String  @db.VarChar(500)
  isCorrect  Boolean @default(false)
  sortOrder  Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, sortOrder])
  @@map("question_options")
}

/// Imtihonga biriktirilgan savol. Ball shu yerda saqlanadi — savollar bazasidagi
/// standart ball keyin o'zgarsa, o'tkazilgan imtihon natijasi o'zgarmaydi.
model ExamQuestion {
  id         String @id @default(cuid())
  examId     String
  questionId String
  points     Int    @db.SmallInt
  sortOrder  Int    @default(0)

  exam             Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  question         Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers          ExamAnswer[]
  attemptQuestions AttemptQuestion[]

  @@unique([examId, questionId])
  @@index([examId, sortOrder])
  @@map("exam_questions")
}

/// O'quvchining imtihon urinishi. Bir imtihonda bir necha urinish bo'lishi mumkin
/// (`attemptNo`), lekin yakuniy natija `ExamResult` ga yoziladi — mavjud hisobotlar
/// va XP mantig'i o'zgarishsiz ishlayveradi.
model ExamAttempt {
  id          String        @id @default(cuid())
  examId      String
  studentId   String
  attemptNo   Int           @default(1) @db.SmallInt
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?
  gradedById  String?
  /// Yig'ilgan ball va imtihonning umumiy bali
  score       Int           @default(0) @db.SmallInt
  maxScore    Int           @default(0) @db.SmallInt
  percentage  Int           @default(0) @db.SmallInt
  passed      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  exam      Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy  User?             @relation(fields: [gradedById], references: [id], onDelete: SetNull)
  answers   ExamAnswer[]
  questions AttemptQuestion[]

  @@unique([examId, studentId, attemptNo])
  @@index([examId, status])
  @@index([studentId, submittedAt])
  @@map("exam_attempts")
}

model ExamAnswer {
  id             String   @id @default(cuid())
  attemptId      String
  examQuestionId String
  questionId     String
  /// Tanlangan variantlar (bitta yoki bir nechta)
  optionIds      String[]
  /// Matnli javob
  text           String?  @db.VarChar(2000)
  /// FILE_UPLOAD savoliga javob fayli
  filePath       String?  @db.VarChar(500)
  /// Avtomatik yoki qo'lda baholangan ball
  score          Int      @default(0) @db.SmallInt
  /// `null` — hali baholanmagan (matnli javob)
  isCorrect      Boolean?
  feedback       String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attempt      ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestion ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, examQuestionId])
  @@index([questionId])
  @@map("exam_answers")
}

/// Urinish boshlangandagi savol **snapshoti** (TZ §25): tartib, variantlar tartibi, matn va
/// javob kaliti muzlatiladi — savol keyin tahrirlansa ham urinish o'zgarmaydi.
model AttemptQuestion {
  id             String   @id @default(cuid())
  attemptId      String
  examQuestionId String
  sortOrder      Int
  points         Int      @db.SmallInt
  /// O'quvchiga ko'rinadigan qism: {text, type, options:[{id,text}]}
  snapshot       Json
  /// Faqat serverda: {correctOptionIds, acceptedAnswers}
  answerKey      Json
  createdAt      DateTime @default(now())

  attempt      ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestion ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, examQuestionId])
  @@index([attemptId, sortOrder])
  @@map("attempt_questions")
}

/// Kurs yakunlangani haqidagi sertifikat.
///
/// Ism, kurs va o'qituvchi nomi **nusxa (snapshot) sifatida** saqlanadi: keyin o'quvchi
/// ismi tahrirlansa yoki kurs o'chirilsa ham berilgan sertifikat o'zgarmaydi — bu hujjat,
/// jonli ma'lumot emas.
model Certificate {
  id             String    @id @default(cuid())
  /// Foydalanuvchiga ko'rinadigan raqam: CRT-2026-000123
  number         Int       @unique @default(autoincrement())
  /// Ochiq tekshirish uchun taxmin qilib bo'lmaydigan kalit (/verify/<token>)
  verifyToken    String    @unique @db.VarChar(64)
  studentId      String
  courseId       String?
  groupId        String?
  /// Berilgan paytdagi qiymatlar — keyin o'zgarmaydi
  studentName    String    @db.VarChar(200)
  courseName     String    @db.VarChar(150)
  teacherName    String?   @db.VarChar(200)
  branchName     String?   @db.VarChar(100)
  startDate      DateTime  @db.Date
  completionDate DateTime  @db.Date
  /// Yakuniy natija (foiz) va baho — bo'lmasligi ham mumkin
  percentage     Int?      @db.SmallInt
  grade          String?   @db.VarChar(4)
  note           String?   @db.VarChar(500)
  issuedAt       DateTime  @default(now())
  issuedById     String?
  /// Bekor qilingan sertifikat tekshiruvda "haqiqiy emas" deb ko'rsatiladi
  revokedAt      DateTime?
  revokedById    String?
  revokeReason   String?   @db.VarChar(255)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  issuedBy  User?   @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedBy User?   @relation("CertificateRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([studentId, issuedAt])
  @@index([courseId])
  @@index([issuedAt])
  @@map("certificates")
}

model Exam {
  id               String     @id @default(cuid())
  title            String     @db.VarChar(200)
  description      String?
  courseId         String?
  groupId          String
  teacherId        String?
  date             DateTime   @db.Date
  maxScore         Int        @default(100) @db.SmallInt
  passScore        Int?       @db.SmallInt
  /// Imtihon davomiyligi (daqiqa). Bo'sh — vaqt chegarasi yo'q
  durationMinutes  Int?       @db.SmallInt
  /// Ruxsat etilgan urinishlar soni (0 — cheklanmagan)
  maxAttempts      Int        @default(0) @db.SmallInt
  xpReward         Int        @default(50)
  status           ExamStatus @default(PLANNED)
  type             ExamType   @default(MONTHLY_EXAM)
  /// O'quvchi kabinetdan o'zi topshiradi
  isOnline         Boolean    @default(false)
  /// Topshirish oynasi (bo'lmasa — cheklanmagan)
  startAt          DateTime?
  endAt            DateTime?
  shuffleQuestions Boolean    @default(false)
  shuffleOptions   Boolean    @default(false)
  /// Blueprint: {total, topics:[{topicId,percent}], difficulty:{EASY,MEDIUM,HARD}} — har o'quvchiga alohida variant
  blueprint        Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  course    Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher   User?          @relation("ExamTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  results   ExamResult[]
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([groupId, date])
  @@index([status, date])
  @@index([createdAt])
  @@map("exams")
}

model ExamResult {
  id         String   @id @default(cuid())
  examId     String
  studentId  String
  score      Int      @db.SmallInt
  /// score / maxScore * 100
  percentage Int      @db.SmallInt
  grade      String?  @db.VarChar(4)
  comment    String?  @db.VarChar(500)
  gradedById String?
  gradedAt   DateTime @default(now())
  xpAwarded  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  exam     Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy User?   @relation("ExamResultGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("exam_results")
}

/// O‘quvchining oylik kesimdagi holati (progress grafigi uchun)
model StudentProgressSnapshot {
  id             String   @id @default(cuid())
  studentId      String
  year           Int
  month          Int      @db.SmallInt
  attendanceRate Int      @default(0) @db.SmallInt
  homeworkRate   Int      @default(0) @db.SmallInt
  averageScore   Int      @default(0) @db.SmallInt
  totalXp        Int      @default(0)
  levelNumber    Int      @default(1) @db.SmallInt
  debtRemaining  Decimal  @default(0) @db.Decimal(14, 2)
  /// Mavzular o'zlashtirishining o'rtachasi (0–100); baho yo'q bo'lsa null
  masteryScore   Int?     @db.SmallInt
  /// O'zlashtirilgan (MASTERED) mavzular soni
  topicsMastered Int      @default(0) @db.SmallInt
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, year, month])
  @@index([year, month])
  @@map("student_progress_snapshots")
}

// ---------------------------------------------------------------------
// TARGET VA ALERTLAR
// ---------------------------------------------------------------------

model SalesTarget {
  id          String     @id @default(cuid())
  userId      String?
  year        Int
  month       Int        @db.SmallInt
  type        TargetType
  targetValue Decimal    @db.Decimal(14, 2)
  note        String?    @db.VarChar(255)
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User? @relation("SalesTargetUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("SalesTargetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, year, month, type])
  @@index([year, month])
  @@map("sales_targets")
}

/// Owner/Admin uchun ogohlantirishlar (yuqori qarz, past davomat va h.k.)
model Alert {
  id           String        @id @default(cuid())
  type         AlertType
  severity     AlertSeverity @default(WARNING)
  title        String        @db.VarChar(200)
  message      String
  entityType   String?       @db.VarChar(50)
  entityId     String?       @db.VarChar(50)
  metadata     Json?
  /// Bir xil ogohlantirish takrorlanmasligi uchun: "high-debt:2026-09"
  dedupeKey    String?       @unique @db.VarChar(150)
  resolvedAt   DateTime?
  resolvedById String?
  /// "O‘qildi" — kim birinchi ko‘rgan; daraja oshsa qayta o‘qilmagan bo‘ladi
  readAt       DateTime?
  readById     String?
  createdAt    DateTime      @default(now())

  resolvedBy User? @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  readBy     User? @relation("AlertReadBy", fields: [readById], references: [id], onDelete: SetNull)

  @@index([resolvedAt, createdAt])
  @@index([resolvedAt, readAt])
  @@index([type, createdAt])
  @@index([severity])
  @@map("alerts")
}

enum CommissionEntryKind {
  ACCRUAL
  REVERSAL
  CARRY_OVER
}

/// O‘qituvchi foizining tarixi: har bir to‘lovdan (+), bekor qilingan to‘lovdan (−) va salbiy
/// qoldiqni keyingi oyga ko‘chirishdan yozuv. Yozuvlar o‘chirilmaydi — tuzatish teskari yozuv bilan.
model CommissionEntry {
  id             String              @id @default(cuid())
  /// Takrorlanmaslik kaliti: payment:<id>:accrual, payment:<id>:reversal, period:<id>:carry-out
  sourceKey      String              @unique @db.VarChar(120)
  teacherId      String
  paymentId      String?
  kind           CommissionEntryKind
  /// Hisob asosi: to‘lov summasi (bekor qilinganda manfiy)
  baseAmount     Decimal             @db.Decimal(14, 2)
  percentage     Decimal             @default(0) @db.Decimal(5, 2)
  amount         Decimal             @db.Decimal(14, 2)
  currency       String              @default("UZS") @db.VarChar(3)
  /// Qaysi oy maoshiga kiradi
  year           Int
  month          Int                 @db.SmallInt
  occurredAt     DateTime
  salaryPeriodId String?
  reason         String?             @db.VarChar(255)
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  teacher      User                 @relation("CommissionTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  payment      Payment?             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  salaryPeriod TeacherSalaryPeriod? @relation(fields: [salaryPeriodId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("CommissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([teacherId, year, month])
  @@index([paymentId])
  @@index([salaryPeriodId])
  @@map("commission_entries")
}

enum PayrollAdjustmentType {
  BONUS
  PENALTY
}

enum PayrollAdjustmentCategory {
  ATTENDANCE
  RETENTION
  PERFORMANCE
  MONTHLY
  SPECIAL
  LATENESS
  ABSENCE
  DISCIPLINE
  OTHER
}

enum SalaryPaymentKind {
  SALARY
  ADVANCE
}

/// Maoshga bonus yoki jarima: summa, sabab, sana, kim kiritgani va kim tasdiqlagani.
/// O‘chirilmaydi — bekor qilinganda voidedAt va sabab yoziladi.
model PayrollAdjustment {
  id             String                    @id @default(cuid())
  salaryPeriodId String
  type           PayrollAdjustmentType
  category       PayrollAdjustmentCategory
  amount         Decimal                   @db.Decimal(14, 2)
  reason         String                    @db.VarChar(255)
  date           DateTime                  @db.Date
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?                   @db.VarChar(255)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  salaryPeriod TeacherSalaryPeriod @relation(fields: [salaryPeriodId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("AdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User?               @relation("AdjustmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  voidedBy     User?               @relation("AdjustmentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([salaryPeriodId])
  @@index([type, date])
  @@map("payroll_adjustments")
}

enum EmployeePosition {
  ADMINISTRATOR
  MANAGER
  SALES_MANAGER
  CALL_CENTER
  ACCOUNTANT
  CLEANER
  SECURITY
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
}

/// O‘qituvchidan tashqari xodimlar (administrator, buxgalter, farrosh...). Tizim akkaunti ixtiyoriy.
/// Maoshi TeacherSalaryPeriod (umumiy payroll davri) orqali hisoblanadi.
model Employee {
  id                String           @id @default(cuid())
  userId            String?          @unique
  firstName         String           @db.VarChar(100)
  lastName          String           @db.VarChar(100)
  phone             String?          @db.VarChar(32)
  email             String?          @db.VarChar(255)
  /// Bo'lim: "Sotuv", "O'quv bo'limi", "Buxgalteriya" — markaz o'zi nomlaydi
  department        String?          @db.VarChar(100)
  position          EmployeePosition
  /// Oylik belgilangan maosh (oy o‘rtasida kirgan/ketganda kunlarga proporsional)
  baseSalary        Decimal          @default(0) @db.Decimal(14, 2)
  status            EmployeeStatus   @default(ACTIVE)
  hireDate          DateTime         @db.Date
  terminationDate   DateTime?        @db.Date
  /// Mehnat shartnomasi
  contractNumber    String?          @unique @db.VarChar(50)
  contractStartDate DateTime?        @db.Date
  /// Muddatsiz shartnomada bo'sh qoladi
  contractEndDate   DateTime?        @db.Date
  /// Maxfiy ma'lumot — `employee.sensitive` ruxsati bo'lmasa javobda qaytarilmaydi
  birthDate         DateTime?        @db.Date
  address           String?          @db.VarChar(255)
  passportNumber    String?          @db.VarChar(32)
  emergencyContact  String?          @db.VarChar(120)
  emergencyPhone    String?          @db.VarChar(32)
  note              String?          @db.VarChar(500)
  createdById       String?
  branchId          String           @default("branch_main")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user          User?                 @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy     User?                 @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  salaryPeriods TeacherSalaryPeriod[]
  documents     Document[]
  leaves        EmployeeLeave[]

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([status])
  @@index([position])
  @@index([department])
  @@index([contractEndDate])
  @@map("employees")
}

/// Ta'til turi
enum LeaveType {
  VACATION
  SICK
  UNPAID
  MATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Xodimning ta'til/dam olish arizasi. Tasdiqlangan ta'til xodim holatini **o'zgartirmaydi** —
/// "bugun ta'tilda" degan javob sanalardan hisoblanadi, shunda qo'lda qo'yilgan holat buzilmaydi.
model EmployeeLeave {
  id            String      @id @default(cuid())
  employeeId    String
  type          LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  /// Kunlar soni (ikkala chekka kun ham kiradi) — yozuvda muzlatiladi
  days          Int         @db.SmallInt
  reason        String?     @db.VarChar(255)
  status        LeaveStatus @default(PENDING)
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?     @db.VarChar(255)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy User?    @relation("LeaveRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?    @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId, startDate])
  @@index([status, startDate])
  @@index([startDate, endDate])
  @@map("employee_leaves")
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

/// To‘lovni (qisman) qaytarish. Kvitansiya o‘chirilmaydi: qaytarilgan pul alohida yozuv,
/// daftarda REFUND tranzaksiyasi (kassadan chiqim).
model PaymentRefund {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  paymentId     String
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod
  accountId     String?
  refundedAt    DateTime      @default(now())
  reason        String        @db.VarChar(255)
  transactionId String        @unique
  createdById   String?
  createdAt     DateTime      @default(now())

  payment     Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  account     FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transaction Transaction       @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation("PaymentRefundCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([refundedAt])
  @@map("payment_refunds")
}

/// Moliyaviy oy. Yopilgandan keyin shu oy sanasi bilan pul yozuvi qo‘shilmaydi va bekor qilinmaydi —
/// tuzatish ochiq oyda teskari yozuv bilan kiritiladi.
model FinancialPeriod {
  id           String                @id @default(cuid())
  year         Int
  month        Int                   @db.SmallInt
  status       FinancialPeriodStatus @default(OPEN)
  /// Yopilgan paytdagi yakunlar: tushum, xarajat, qaytarishlar, kassa qoldiqlari
  summary      Json?
  closedAt     DateTime?
  closedById   String?
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?               @db.VarChar(255)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  closedBy   User? @relation("FinancialPeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  reopenedBy User? @relation("FinancialPeriodReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull)

  @@unique([year, month])
  @@map("financial_periods")
}

enum ExpenseStatus {
  /// Takroriy xarajatdan yaratilgan, to‘lov kutilmoqda (tasdiq shart emas)
  UPCOMING
  /// Chegara summadan katta — rahbar tasdig‘i kutilmoqda
  PENDING
  APPROVED
  REJECTED
  PAID
}

/// Har oy takrorlanadigan xarajat (ijara, internet, dastur). Tizim oy boshida kutilayotgan
/// xarajat yaratadi — pul avtomatik yechilmaydi, to‘lov qo‘lda tasdiqlanadi.
model RecurringExpense {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(150)
  categoryId  String
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod @default(CASH)
  accountId   String?
  vendor      String?       @db.VarChar(150)
  /// Oyning qaysi kuni (1–28)
  dayOfMonth  Int           @db.SmallInt
  startDate   DateTime      @db.Date
  endDate     DateTime?     @db.Date
  isActive    Boolean       @default(true)
  note        String?       @db.VarChar(255)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category  ExpenseCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account   FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("RecurringExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expenses  Expense[]

  @@index([isActive])
  @@map("recurring_expenses")
}

// ---------------------------------------------------------------------
// REFERAL VA CHEGIRMALAR
// ---------------------------------------------------------------------

/// Chegirma turlari. `CUSTOM` — qoidasiz, qo'lda beriladigan chegirma (sabab majburiy).
enum DiscountType {
  FAMILY
  REFERRAL
  PROMO_CODE
  PREPAY_3
  PREPAY_6
  FIRST_PAYMENT
  CUSTOM
}

enum DiscountValueType {
  PERCENT
  AMOUNT
}

/// Chegirma qoidasi — katalog yozuvi. Qoida o'zgarsa **berilgan** chegirmalar o'zgarmaydi:
/// `StudentDiscount` qiymatlarni nusxa sifatida saqlaydi.
model DiscountRule {
  id          String            @id @default(cuid())
  key         String            @unique @db.VarChar(50)
  name        String            @db.VarChar(120)
  type        DiscountType
  valueType   DiscountValueType @default(PERCENT)
  /// PERCENT uchun 0–100, AMOUNT uchun so'm
  value       Decimal           @db.Decimal(14, 2)
  /// Boshqa chegirmalar ustiga qo'shilishi mumkinmi (stacking)
  stackable   Boolean           @default(true)
  /// Kichik raqam avval hisoblanadi
  priority    Int               @default(0) @db.SmallInt
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0) @db.SmallInt
  /// Amal qilish oralig'i (ko'rsatilmasa — cheksiz)
  startsAt    DateTime?
  endsAt      DateTime?
  description String?           @db.VarChar(255)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  promoCodes PromoCode[]
  discounts  StudentDiscount[]

  @@index([isActive, sortOrder])
  @@index([type])
  @@map("discount_rules")
}

/// Promo kod — qoidaga ishlovchi kalit. Kod katta harflarda saqlanadi.
model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique @db.VarChar(32)
  ruleId      String
  /// 0 — cheksiz
  usageLimit  Int       @default(0) @db.SmallInt
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  note        String?   @db.VarChar(255)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rule      DiscountRule      @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  createdBy User?             @relation("PromoCodeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  discounts StudentDiscount[]

  @@index([isActive])
  @@map("promo_codes")
}

/// O'quvchiga berilgan chegirma. **O'chirilmaydi** — bekor qilinadi (`revokedAt`), shunda
/// shartnoma narxi qanday shakllangani tarixi saqlanadi.
model StudentDiscount {
  id           String            @id @default(cuid())
  studentId    String
  ruleId       String?
  promoCodeId  String?
  /// Berilgan paytdagi nusxa — qoida keyin o'zgarsa ham hujjat o'zgarmaydi
  label        String            @db.VarChar(120)
  type         DiscountType
  valueType    DiscountValueType
  value        Decimal           @db.Decimal(14, 2)
  /// Shartnoma narxidan chegirilgan summa (so'm) — hisoblangach muzlatiladi
  amount       Decimal           @db.Decimal(14, 2)
  note         String?           @db.VarChar(255)
  grantedById  String?
  createdAt    DateTime          @default(now())
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?           @db.VarChar(255)

  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rule      DiscountRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  promoCode PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  grantedBy User?         @relation("DiscountGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy User?         @relation("DiscountRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  referral  Referral?     @relation("ReferralBonusDiscount")

  @@index([studentId, revokedAt])
  @@index([type])
  @@map("student_discounts")
}

/// Taklif holati: lead kelgan → o'quvchiga aylandi → bonus berildi.
enum ReferralStatus {
  PENDING
  CONVERTED
  REWARDED
  CANCELLED
}

/// Kim kimni taklif qilgani. Lead referral kod bilan kelganda yoziladi va lead o'quvchiga
/// aylanganda `CONVERTED` bo'ladi. Bonus **avtomatik berilmaydi** — xodim aniq harakat bilan
/// beradi, shunda pul harakati doim ko'rinib turadi.
model Referral {
  id                String         @id @default(cuid())
  referrerStudentId String
  leadId            String?        @unique
  referredStudentId String?        @unique
  status            ReferralStatus @default(PENDING)
  /// Bonus summasi (berilganda yoziladi)
  bonusAmount       Decimal        @default(0) @db.Decimal(14, 2)
  /// Bonus qaysi chegirma sifatida berilgani
  bonusDiscountId   String?        @unique
  rewardedById      String?
  rewardedAt        DateTime?
  note              String?        @db.VarChar(255)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  referrer      Student          @relation("ReferralReferrer", fields: [referrerStudentId], references: [id], onDelete: Cascade)
  referred      Student?         @relation("ReferralReferred", fields: [referredStudentId], references: [id], onDelete: SetNull)
  lead          Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bonusDiscount StudentDiscount? @relation("ReferralBonusDiscount", fields: [bonusDiscountId], references: [id], onDelete: SetNull)
  rewardedBy    User?            @relation("ReferralRewardedBy", fields: [rewardedById], references: [id], onDelete: SetNull)

  @@index([referrerStudentId, status])
  @@index([status, createdAt])
  @@map("referrals")
}

// ---------------------------------------------------------------------
// FIKR-MULOHAZA VA NPS
// ---------------------------------------------------------------------

/// Fikr nima haqida: o'qituvchi, kurs, markaz yoki tavsiya ehtimoli (NPS)
enum FeedbackType {
  TEACHER
  COURSE
  ACADEMY
  NPS
}

/// O'quvchi (yoki ota-ona) fikri. Anonim bo'lsa ham o'quvchi bog'lanadi — bir xil
/// so'rovga ikki marta javob bermasligi va statistika to'g'ri bo'lishi uchun; lekin
/// ismi xodimga **ko'rsatilmaydi** (`isAnonymous`).
model Feedback {
  id          String       @id @default(cuid())
  studentId   String
  type        FeedbackType
  teacherId   String?
  courseId    String?
  groupId     String?
  /// 1–5 yulduz (NPS uchun null)
  rating      Int?         @db.SmallInt
  /// 0–10 tavsiya ehtimoli (faqat NPS uchun)
  npsScore    Int?         @db.SmallInt
  comment     String?      @db.VarChar(1000)
  isAnonymous Boolean      @default(false)
  /// Past baho bilan ishlanganmi (xodim ko'rib chiqdi)
  handledAt   DateTime?
  handledById String?
  handleNote  String?      @db.VarChar(500)
  branchId    String       @default("branch_main")
  createdAt   DateTime     @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   User?   @relation("FeedbackTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  course    Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  handledBy User?   @relation("FeedbackHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([type, createdAt])
  @@index([teacherId, createdAt])
  @@index([studentId, createdAt])
  @@index([branchId])
  @@index([handledAt])
  @@map("feedback")
}

// ---------------------------------------------------------------------
// INVENTAR (OMBOR)
// ---------------------------------------------------------------------

/// Mahsulot turkumi: Kitoblar, Forma, Texnika, Kantselyariya...
model ProductCategory {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0) @db.SmallInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
  @@map("product_categories")
}

/// Ombordagi mahsulot. `quantity` — harakatlardan hisoblangan joriy qoldiq (kesh qiymat):
/// har bir `StockMovement` uni bitta tranzaksiyada yangilaydi, shuning uchun ro'yxat tez ochiladi.
model Product {
  id          String   @id @default(cuid())
  /// Filial ichida takrorlanmas kod: KITOB-01
  sku         String   @db.VarChar(50)
  name        String   @db.VarChar(150)
  categoryId  String
  /// O'lchov birligi: dona, komplekt, quti
  unit        String   @default("dona") @db.VarChar(20)
  /// Sotish narxi va tannarx (oxirgi kirimdan)
  price       Decimal  @default(0) @db.Decimal(14, 2)
  cost        Decimal  @default(0) @db.Decimal(14, 2)
  /// Joriy qoldiq
  quantity    Int      @default(0)
  /// Shu miqdordan kam qolsa "kam qoldi" deb belgilanadi (0 — kuzatilmaydi)
  minQuantity Int      @default(0) @db.SmallInt
  isActive    Boolean  @default(true)
  note        String?  @db.VarChar(500)
  branchId    String   @default("branch_main")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([branchId, sku])
  @@index([branchId, isActive])
  @@index([categoryId])
  @@index([quantity])
  @@map("products")
}

/// Ombor harakati turi. Kirim: PURCHASE, RETURN, TRANSFER_IN, ADJUSTMENT (musbat);
/// chiqim: SALE, DAMAGE, TRANSFER_OUT, ADJUSTMENT (manfiy).
enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  DAMAGE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

/// Ombor harakati — **hech qachon o'chirilmaydi**. Xato yozuv teskari harakat bilan tuzatiladi,
/// shunda qoldiq tarixi to'liq qoladi (moliyaviy daftar bilan bir xil tamoyil).
model StockMovement {
  id                  String            @id @default(cuid())
  productId           String
  type                StockMovementType
  /// Har doim musbat; yo'nalishni `type` belgilaydi
  quantity            Int
  /// Harakatdan keyingi qoldiq — tarixni qayta hisoblamasdan o'qish uchun
  balanceAfter        Int
  /// Bir dona narxi (kirimda tannarx, sotuvda sotish narxi)
  unitPrice           Decimal           @default(0) @db.Decimal(14, 2)
  totalAmount         Decimal           @default(0) @db.Decimal(14, 2)
  reason              String?           @db.VarChar(255)
  /// Sotuv kimga qilingani (ixtiyoriy)
  studentId           String?
  /// Ko'chirishda ikkinchi filial
  counterpartBranchId String?
  /// Pul yozuvi shu harakat bilan birga yaratilgan bo'lsa
  incomeId            String?           @unique
  expenseId           String?           @unique
  createdById         String?
  createdAt           DateTime          @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------
// AI YORDAMCHI
// ---------------------------------------------------------------------

/// AI yordamchiga berilgan savol va unga qaysi "tool" javob bergani.
///
/// Yozuv **audit uchun**: kim nima so'ragani, qaysi ma'lumot ko'rsatilgani va savol
/// tushunilmagan hollar (`toolKey` bo'sh) ko'rinib turadi. Javob matni ham saqlanadi —
/// keyin "bu raqam qayerdan chiqdi?" degan savolga javob bo'ladi.
/// AI akademik tahlil turi (TZ 3.0 §32–41)
enum AiAnalysisKind {
  STUDENT
  GROUP
  HOMEWORK_REVIEW
  PARENT_SUMMARY
  REMEDIAL
}

/// Qaror talab qiladigan tahlil (vazifa bahosi, remedial reja): o'qituvchi tasdiqlaydi (TZ §0: AI — yakuniy hakam emas)
enum AiAnalysisStatus {
  READY
  ACCEPTED
  REJECTED
}

/// Tahlil manbasi: qoidalar (deterministik) yoki til modeli qo'shimchasi bilan
enum AiAnalysisSource {
  RULES
  LLM
}

/// AI akademik tahlil natijasi. **Faktlar** har doim CRM ma'lumotidan kod bilan yig'iladi; til modeli
/// (ulangan bo'lsa) faqat kuzatuv, tavsiya va xulosa matnini yozadi — yangi fakt o'ylab topa olmaydi.
/// Prompt/javobda parol, token, to'lov siri yo'q (§59).
model AiAnalysis {
  id           String           @id @default(cuid())
  kind         AiAnalysisKind
  /// "student" | "group" | "submission"
  subjectType  String           @db.VarChar(20)
  subjectId    String           @db.VarChar(80)
  /// Davr kaliti (masalan hafta "2026-09-21") — takroriy hisobni oldini olish uchun
  periodKey    String?          @db.VarChar(20)
  status       AiAnalysisStatus @default(READY)
  source       AiAnalysisSource @default(RULES)
  /// Qisqa xulosa (ko'rsatish uchun)
  summary      String           @db.VarChar(2000)
  /// {scores?, items: [{type: FACT|OBSERVATION|RECOMMENDATION, text}], ...turga xos maydonlar}
  result       Json
  model        String?          @db.VarChar(60)
  inputTokens  Int?
  outputTokens Int?
  createdById  String?
  decidedById  String?
  decidedAt    DateTime?
  /// Qaror tafsiloti: qabul qilingan ball, yaratilgan vazifa/imtihon va h.k.
  decision     Json?
  createdAt    DateTime         @default(now())

  createdBy User? @relation("AiAnalysisCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy User? @relation("AiAnalysisDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([kind, subjectType, subjectId, createdAt])
  @@index([kind, periodKey])
  @@map("ai_analyses")
}

model AiQuery {
  id         String   @id @default(cuid())
  userId     String?
  question   String   @db.VarChar(500)
  /// Qaysi tool ishlatilgani (topilmasa null)
  toolKey    String?  @db.VarChar(50)
  /// Toolga berilgan parametrlar (davr, filial va h.k.)
  params     Json?
  /// Foydalanuvchiga ko'rsatilgan javob
  answer     String?  @db.VarChar(1000)
  /// Javob topilmagan bo'lsa sabab
  failure    String?  @db.VarChar(255)
  durationMs Int?     @db.SmallInt
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([toolKey, createdAt])
  @@index([createdAt])
  @@map("ai_queries")
}

// ---------------------------------------------------------------------
// AVTOMATLASHTIRISH
// ---------------------------------------------------------------------

/// Qoida qaysi holatda ishga tushadi
enum AutomationTrigger {
  /// O'quvchi ketma-ket N marta darsga kelmadi
  STUDENT_ABSENT_STREAK
  /// To'lov muddatiga N kun qoldi
  PAYMENT_DUE_SOON
  /// To'lov muddati o'tdi
  PAYMENT_OVERDUE
  /// O'quvchining xavf darajasi kritik
  STUDENT_RISK_CRITICAL
  /// Follow-up muddati o'tib ketdi
  FOLLOWUP_OVERDUE
  /// Omborda mahsulot chegaradan kam qoldi
  STOCK_BELOW_MIN
  /// O'quvchi kursni tugatdi — sertifikat berish mumkin
  CERTIFICATE_ELIGIBLE
  /// TZ 3.0 §50: vazifa topshirish ulushi chegaradan past
  HOMEWORK_COMPLETION_LOW
  /// Imtihon natijasi chegaradan past
  EXAM_SCORE_LOW
  /// Mavzu o'zlashtirishi chegaradan past
  MASTERY_LOW
  /// Kabinetga N kundan beri kirmagan
  NO_LOGIN_DAYS
  /// N kundan beri vazifa topshirmagan
  NO_SUBMISSION_DAYS
}

/// Maxsus qoida qachon ishlaydi (TZ §51 "Schedule"). Tizim qoidalarida null — har yurishda
enum AutomationSchedule {
  HOURLY
  DAILY
  WEEKLY
}

/// Avtomatlashtirish yoki xodim yaratgan ish (TZ §51 "Create Task")
enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// Xodim uchun ish: kim, nima, qachongacha. Qoida yaratgan bo'lsa `ruleId` va `dedupeKey` bor —
/// bir holat uchun ikki marta yaratilmaydi.
model Task {
  id          String     @id @default(cuid())
  title       String     @db.VarChar(200)
  description String?    @db.VarChar(2000)
  status      TaskStatus @default(OPEN)
  assigneeId  String
  dueAt       DateTime?
  /// Bog'liq ob'ekt: student / group / homework ...
  entityType  String?    @db.VarChar(30)
  entityId    String?    @db.VarChar(50)
  /// Web'da ochiladigan sahifa (masalan /students/<id>)
  link        String?    @db.VarChar(200)
  ruleId      String?
  dedupeKey   String?    @unique @db.VarChar(200)
  createdById String?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignee  User            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rule      AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueAt])
  @@index([status, createdAt])
  @@map("tasks")
}

/// Bildirishnoma kimga boradi
enum AutomationAudience {
  /// Tegishli ruxsatga ega xodimlar (masalan `debt.view`)
  STAFF
  /// Leadning yoki o'quvchining mas'ul xodimi
  RESPONSIBLE
  /// O'quvchining o'zi (kabinet hisobi bo'lsa)
  STUDENT
  /// Ota-ona (kabinet hisobi bo'lsa)
  PARENT
}

/// Avtomatlashtirish qoidasi. Kalit bo'yicha takrorlanmaydi — sozlamalar tahrirlanadi,
/// yangi qoida yaratilmaydi, shuning uchun tarix chalkashmaydi.
model AutomationRule {
  id              String              @id @default(cuid())
  key             String              @unique @db.VarChar(50)
  name            String              @db.VarChar(120)
  description     String?             @db.VarChar(255)
  trigger         AutomationTrigger
  audience        AutomationAudience  @default(STAFF)
  /// Qoida parametrlari: {absences: 2} yoki {daysBefore: 3}
  params          Json?
  isActive        Boolean             @default(true)
  lastRunAt       DateTime?
  /// Oxirgi yurishda nechta holat topilgani
  lastMatched     Int                 @default(0)
  /// TZ §51: admin yaratgan qoida (tizim qoidasidan farqli — o'chirish mumkin)
  isCustom        Boolean             @default(false)
  /// Shartlar: {threshold, days, courseId, groupId, ...} — zod bilan tekshiriladi
  conditions      Json?
  /// Amallar: [{type: NOTIFY|CREATE_TASK|CREATE_ALERT|ASSIGN_HOMEWORK|RECOMMEND_QUIZ, ...}]
  actions         Json?
  schedule        AutomationSchedule?
  scheduleHour    Int?                @db.SmallInt
  scheduleWeekday Int?                @db.SmallInt
  nextRunAt       DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  updatedBy User?           @relation("AutomationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdBy User?           @relation("AutomationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  runs      AutomationRun[]
  tasks     Task[]

  @@index([isActive, trigger])
  @@map("automation_rules")
}

/// Qoidaning bitta yurishi. Nechta holat topilgani, nechta bildirishnoma yuborilgani va
/// xatolik bo'lsa sababi yoziladi — "nega xabar kelmadi?" degan savolga javob shu yerda.
model AutomationRun {
  id          String   @id @default(cuid())
  ruleId      String
  startedAt   DateTime @default(now())
  durationMs  Int?
  /// Shartga mos kelgan holatlar soni
  matched     Int      @default(0)
  /// Yuborilgan bildirishnomalar (takrorlanganlari hisobga olinmaydi)
  notified    Int      @default(0)
  /// Takroriy bo'lgani uchun o'tkazib yuborilganlar
  skipped     Int      @default(0)
  /// Maxsus qoida: bajarilgan amallar (ish, ogohlantirish, vazifa qoralamasi...)
  actionsDone Int      @default(0)
  error       String?  @db.VarChar(500)

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, startedAt])
  @@index([startedAt])
  @@map("automation_runs")
}

// ---------------------------------------------------------------------
// ONLAYN TO'LOV (provayder abstraksiyasi)
// ---------------------------------------------------------------------

/// To'lov provayderi. `SANDBOX` — sinov uchun: imzo HMAC-SHA256 bilan tekshiriladi,
/// shuning uchun butun oqimni haqiqiy provayder kalitlarisiz sinab ko'rish mumkin.
enum PaymentProviderKey {
  CLICK
  PAYME
  UZUM
  SANDBOX
}

/// To'lov so'rovining holati.
///  PENDING   — yaratildi, provayderdan javob kutilmoqda
///  PAID      — provayder to'lovni tasdiqladi va `Payment` yozildi
///  CANCELLED — foydalanuvchi bekor qildi
///  FAILED    — provayder rad etdi
///  REFUNDED  — provayder orqali qaytarildi
enum PaymentIntentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
  REFUNDED
}

/// Onlayn to'lov so'rovi (intent).
///
/// **Nega alohida jadval:** `Payment` — pul **kelganini** bildiradigan yozuv, uni faqat
/// tasdiqlangan to'lovda yaratamiz. Provayder bilan yozishmaning o'zi (so'rov yaratildi, kutildi,
/// bekor qilindi) alohida hayot tsikliga ega — u shu yerda saqlanadi. Webhook ikki marta kelsa
/// `externalId` unikaligi ikkinchi `Payment` yaratilishiga yo'l qo'ymaydi.
model PaymentIntent {
  id          String              @id @default(cuid())
  provider    PaymentProviderKey
  /// Provayderdagi tranzaksiya raqami — takroriy webhookni aniqlash kaliti
  externalId  String              @db.VarChar(120)
  studentId   String
  amount      Decimal             @db.Decimal(14, 2)
  status      PaymentIntentStatus @default(PENDING)
  /// To'lov tasdiqlangach yaratilgan kvitansiya
  paymentId   String?             @unique
  /// Provayderdan kelgan xom ma'lumot (tekshiruv va nizo hal qilish uchun)
  payload     Json?
  failureText String?             @db.VarChar(255)
  /// Kim yaratgan (CRM ichidan yaratilsa); webhookdan kelsa bo'sh
  createdById String?
  paidAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("PaymentIntentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@map("payment_intents")
}
