# ------------------------------------------------------------
# Sales CRM backend — environment o'zgaruvchilari
# Nusxa oling:  cp .env.example .env   (Windows: copy .env.example .env)
# ------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL ulanishi (docker-compose.yml dagi qiymatlar bilan mos)
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:5432/crm?schema=public"

# Ixtiyoriy. Oddiy PostgreSQL'da kerak emas (Prisma shadow bazani o'zi yaratadi).
# Docker'siz lokal baza (npm run db:local) ishlatilsa:
#   DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
#   SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# SHADOW_DATABASE_URL=

# Kamida 32 belgili, bir-biridan farqli tasodifiy qatorlar.
# Yaratish:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Frontend manzili (CORS). Bir nechta bo'lsa vergul bilan: http://a.uz,http://b.uz
CLIENT_URL=http://localhost:5173

# Reverse proxy (Nginx) orqasida ishlasa 1 qiling — to'g'ri IP aniqlash va rate limit uchun
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Shu millisekunddan uzoq so'rovlar logga "Sekin so'rov" bo'lib tushadi
SLOW_REQUEST_MS=800

# Parolni tiklash havolasi amal qilish muddati (daqiqa)
PASSWORD_RESET_EXPIRES_MINUTES=30

# Frontend va API turli subdomenlarda bo'lsa (crm.example.uz + api.example.uz): .example.uz
COOKIE_DOMAIN=

# Yuklangan hujjatlar (cheklar) papkasi — public emas. Productionda zaxiraga qo'shing!
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# SMTP — parolni tiklash xatlari. Bo'sh qoldirilsa, development'da havola server logiga yoziladi.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sales CRM <no-reply@example.com>"

# Integratsion testlar uchun ALOHIDA baza — testlar uni har safar tozalaydi!
# Masalan: postgresql://crm:crm_dev_password@localhost:5432/crm_test?schema=public
TEST_DATABASE_URL=

# Vaqt mintaqasi: barcha "bugun/oy" hisoblari shu siljish bo'yicha (Toshkent = +300)
APP_UTC_OFFSET_MINUTES=300

# Telegram — o'quvchi va ota-onaga xabar yuborish. Bo'sh qoldirilsa modul o'chiq ishlaydi:
# xabarlar navbatga tushadi, lekin yuborilmaydi (CRM ichidagi bildirishnomalar ishlayveradi).
#   1. @BotFather da bot oching -> token oling
#   2. TELEGRAM_WEBHOOK_SECRET — o'zingiz o'ylab topgan uzun tasodifiy satr (kamida 32 belgi)
#   3. Webhook: https://<domen>/api/telegram/webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Sinov uchun: bot Telegramdan yangiliklarni o'zi so'rab turadi (tunnel/HTTPS kerak emas).
# Productionda 'false' bo'lishi shart - u yerda webhook ishlatiladi.
TELEGRAM_POLLING=false

# Rol ruxsatlari keshi (ms). Bitta serverda 60000 yetarli; bir nechta nusxa ishlayotganda
# kamaytiring yoki 0 qo'ying (kesh butunlay o'chadi).
PERMISSION_CACHE_TTL_MS=60000

# Onlayn to'lov: sinov provayderi imzo kaliti. Bo'sh bo'lsa webhook yo'li yopiq (503).
# Click/Payme ulanganda ularning kalitlari shu yerga qo'shiladi.
PAYMENT_SANDBOX_SECRET=
