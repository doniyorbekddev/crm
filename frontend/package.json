{
  "name": "@crm/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Sales CRM web ilovasi — React + TypeScript + Vite + Tailwind CSS",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
